---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { characters } from '../lib/assets';
import { kakaoChannel } from '../lib/links';

const title = '소개 — 행동을 데이터로 연결하는 글루밍';
const description =
  '글루밍은 혈당을 자동으로 재주는 작은 센서 값을 식사·운동 같은 행동과 잇는 웰니스 습관 보조 서비스예요. 이미 오른 혈당을 뒤늦게 확인하는 대신, 앞으로의 혈당 변화를 미리 살펴보는 것을 돕습니다.';

// 가치 블록 — 오른 뒤에 확인 vs 미리 살펴보기
const beliefs = [
  {
    label: '오른 뒤에야 알게 될 때',
    title: '오른 다음에 보면 아쉽더라고요',
    body: '식사를 마치고 그래프를 보면 “아, 아까 그걸” 하게 되잖아요. 기록이 쌓여도 “그래서 다음엔 뭘 다르게 하지?”는 여전히 남고요.',
    tone: 'muted',
  },
  {
    label: '미리 살펴볼 때',
    title: '고르기 전에 한 번 살펴봐요',
    body: '먹기 전, 움직이기 전에 흐름을 미리 보면 마음이 한결 가벼워요. 정답은 아니지만, 고르는 데 도움이 될 거예요.',
    tone: 'primary',
  },
  {
    label: '스스로 선택',
    title: '고르는 건 언제나 나예요',
    body: '글루밍이 대신 정하지는 않아요. 내 몸의 흐름을 알아가도록 옆에서 거들고, 작은 습관이 이어지도록 같이 응원할게요.',
    tone: 'gold',
  },
];

// 진행 단계
const roadmap = [
  { phase: '기획', desc: '무엇을, 어떻게 만들지 다듬었어요.', done: true },
  { phase: '베타', desc: '핵심 경험을 작게 만들어 보며 손질했어요.', done: true },
  {
    phase: '정식 출시',
    desc: 'App Store와 Google Play에서 내려받으실 수 있어요.',
    current: true,
  },
  {
    phase: '계속 다듬는 중',
    desc: '써주신 분들의 이야기를 들으며 조금씩 나아지고 있어요.',
    done: false,
  },
];

const guide = characters[0]; // 도디
---

<Layout title={title} description={description}>
  <!-- 1. HERO -->
  <section class="section hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Gluming — Our Story</span>
        <h1 class="hero-title">
          나의 몸을 이해하는<br />
          <span class="accent">조금 더 다정한 방법</span>
        </h1>
        <p class="hero-lead">
          글루밍은 몸에 붙이는 작은 혈당 센서(CGM)가 잰 값을 식사·운동 같은
          <strong>일상의 행동</strong>과 이어주는 웰니스 습관 보조 서비스예요.<br />
          지난 그래프를 되돌아보는 데서 멈추지 않고, 무언가를 선택하기
          <strong>전에</strong> 내 혈당이 어떻게 변할지 가볍게 미리 살펴보도록 도와드릴게요.
        </p>
        <p class="hero-lead hero-lead-soft">
          정답을 정해 드리진 않아요.<br />
          대신 편한 마음으로 고르실 수 있게, 옆에서 살짝 거들게요.
        </p>
        <div class="hero-actions">
          <StoreButtons size="lg" />
        </div>
      </div>
      <div class="hero-visual">
        <figure class="hero-figure">
          <div class="hero-figure-glow" aria-hidden="true"></div>
          <Image
            class="hero-figure-img"
            src={guide.states.happy}
            alt={`글루밍 캐릭터 ${guide.name}`}
            width={440}
            height={440}
          />
          <figcaption class="hero-figure-cap">
            <strong>{guide.name}</strong>
            <span>{guide.tagline}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 2. 우리가 믿는 것 -->
  <section class="section beliefs">
    <div class="container">
      <SectionHead eyebrow="01 — Why Before" variant="split">
        왜 ‘행동 전’일까요?
        <Fragment slot="sub">
          지난 기록을 보는 것도 물론 도움이 돼요.<br />
          다만 글루밍은 <strong>고르기 직전</strong>, 그 순간에 옆에 있고 싶었어요.
        </Fragment>
      </SectionHead>
      <ol class="belief-list">
        {
          beliefs.map((b, i) => (
            <li class="belief-item reveal">
              <span class="belief-index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="belief-content">
                <span class="belief-label">{b.label}</span>
                <h3 class="belief-title">{b.title}</h3>
                <p class="belief-body">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3. 진행 단계 -->
  <section id="about-roadmap" class="section roadmap">
    <div class="container">
      <SectionHead eyebrow="02 — Where We Are" variant="split">
        여기까지 왔어요
        <Fragment slot="sub">
          글루밍이 어떻게 걸어왔는지 가볍게 보여드릴게요.<br />
          앞으로도 <strong>저희와 함께해요!</strong>
        </Fragment>
      </SectionHead>
      <ol class="timeline">
        {
          roadmap.map((step) => (
            <li class={`tl-item reveal ${step.current ? 'is-current' : ''} ${step.done ? 'is-done' : ''}`}>
              <span class="tl-dot" aria-hidden="true" />
              <div class="tl-body">
                <h3 class="tl-phase">
                  {step.phase}
                  {step.current && <span class="tl-now">지금 여기</span>}
                </h3>
                <p class="tl-desc">{step.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. 내려받기 · 문의 -->
  <section id="download" class="section download">
    <div class="container">
      <div class="dl-card">
        <span class="eyebrow eyebrow-on-dark">03 — Get the App</span>
        <h2 class="dl-title">지금 바로 시작하실 수 있어요</h2>
        <p class="dl-lead">
          App Store와 Google Play에서 <strong>글루밍</strong>을 내려받으세요.<br />
          궁금한 점이 있으시면 카카오톡 채널로 편하게 말 걸어 주세요.
        </p>
        <div class="dl-actions">
          <StoreButtons size="lg" tone="dark" />
        </div>
        <p class="dl-fine">
          <a href={kakaoChannel} target="_blank" rel="noopener noreferrer">
            카카오톡으로 문의하기 →
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- 6. 의료 비대체 고지 -->
  <section class="section notice-wrap">
    <div class="container">
      <aside class="notice" role="note" aria-label="의료 비대체 안내">
        <span class="notice-badge">안내</span>
        <div class="notice-body">
          <h2 class="notice-title">건강에 관한 중요한 안내예요</h2>
          <p>
            글루밍은 생활습관 관리를 돕는 <strong>웰니스 서비스</strong>이며, 의료
            행위가 아니에요.<br />
            질병의 진단이나 치료를 대신하지 않고, 알려 드리는 정보는 참고용이에요.<br />
            건강과 관련한 판단이나 결정은 <strong>반드시 의사 등 전문가</strong>와
            상의해 주세요.
          </p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero {
    padding-top: clamp(56px, 8vw, 104px);
    border-bottom: 1px solid var(--rule);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-title {
    font-size: var(--fs-h1);
    line-height: var(--lh-title);
    margin-bottom: var(--sp-6);
  }
  .hero-title .accent {
    color: var(--sage-dark);
  }
  .hero-lead {
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.78;
    max-width: 560px;
  }
  .hero-lead strong {
    color: var(--text);
    font-weight: 700;
  }
  .hero-lead-soft {
    margin-top: 16px;
  }
  .hero-actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-figure {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 460px;
    /* 넉넉한 여백으로 캐릭터가 잘리지 않고 숨 쉬도록 */
    padding: clamp(36px, 5vw, 60px) clamp(28px, 4vw, 52px)
      clamp(28px, 4vw, 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-radius: var(--r-lg);
    /* 흰 카드 대신 종이 톤이 은은히 번지는 면 */
    background: radial-gradient(
      120% 90% at 50% 18%,
      color-mix(in srgb, var(--surface) 70%, transparent) 0%,
      var(--warm) 100%
    );
  }
  .hero-figure-glow {
    position: absolute;
    top: 12%;
    left: 50%;
    width: 62%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: var(--r-pill);
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--primary) 22%, transparent) 0%,
      transparent 68%
    );
    filter: blur(6px);
    pointer-events: none;
  }
  .hero-figure-img {
    position: relative;
    z-index: 1;
    width: clamp(200px, 26vw, 300px);
    height: auto;
    object-fit: contain;
  }
  .hero-figure-cap {
    position: relative;
    z-index: 1;
    margin-top: clamp(18px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .hero-figure-cap strong {
    font-weight: 700;
    font-size: clamp(16px, 1.8vw, 18px);
    color: var(--pine);
  }
  .hero-figure-cap span {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ── 우리가 믿는 것 (헤어라인 리스트) ── */
  .belief-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .belief-item {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: clamp(16px, 3vw, 40px);
    padding: clamp(28px, 4vw, 44px) 0;
    border-bottom: 1px solid var(--rule);
  }
  .belief-index {
    font-family: var(--font-serif);
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 400;
    line-height: 1;
    color: var(--sand);
    font-optical-sizing: auto;
  }
  .belief-content {
    max-width: 640px;
  }
  .belief-label {
    display: inline-block;
    margin-bottom: 12px;
    color: var(--sage-dark);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .belief-title {
    font-size: var(--fs-h3);
    letter-spacing: -0.03em;
    line-height: 1.3;
    margin-bottom: var(--sp-3);
  }
  .belief-body {
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: 1.78;
  }


  /* ── 진행 단계 ── */
  #about-roadmap {
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 720px;
    display: grid;
    gap: 4px;
  }
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 18px;
    padding: 18px 0 24px;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 28px;
    bottom: -4px;
    width: 1px;
    background: var(--rule);
  }
  .tl-item:last-child::before {
    display: none;
  }
  .tl-dot {
    position: relative;
    z-index: 1;
    width: 14px;
    height: 14px;
    margin: 6px auto 0;
    border-radius: var(--r-pill);
    background: var(--surface);
    border: 2px solid var(--border-strong);
  }
  .tl-item.is-done .tl-dot {
    background: var(--sage);
    border-color: var(--sage);
  }
  .tl-item.is-current .tl-dot {
    background: var(--sand);
    border-color: var(--sand);
    box-shadow: 0 0 0 5px var(--warm);
  }
  .tl-phase {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: clamp(18px, 2.2vw, 21px);
    margin-bottom: 6px;
  }
  .tl-now {
    padding: 4px 11px;
    border-radius: var(--r-pill);
    border: 1px solid var(--sand);
    color: var(--gold-text);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .tl-desc {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.72;
  }

  /* ── 내려받기 (다크 파인 섹션) ── */
  #download {
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .dl-card {
    position: relative;
    max-width: 760px;
    padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 64px);
    border-radius: var(--r-lg);
    background: var(--pine);
    color: var(--on-dark);
    overflow: hidden;
    isolation: isolate;
  }
  .dl-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--grain);
    background-size: 180px 180px;
    opacity: 0.07;
    pointer-events: none;
  }
  .eyebrow-on-dark {
    color: var(--primary-light);
  }
  .dl-title {
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
    line-height: var(--lh-title);
    color: var(--on-dark);
  }
  .dl-lead {
    margin: var(--sp-5) 0 0;
    max-width: 560px;
    color: color-mix(in srgb, var(--on-dark) 80%, transparent);
    font-size: var(--fs-lead);
    line-height: 1.78;
  }
  .dl-actions {
    margin-top: var(--sp-7);
    display: flex;
  }
  .dl-fine {
    margin-top: var(--sp-5);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }
  .dl-fine a {
    color: var(--primary-light);
    font-weight: 600;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease);
  }
  .dl-fine a:hover {
    border-bottom-color: currentColor;
  }

  /* ── 의료 비대체 고지 ── */
  .notice-wrap {
    padding-top: 0;
  }
  .notice {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: clamp(22px, 3vw, 30px);
    border-radius: var(--r-md);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--coral);
  }
  .notice-badge {
    flex: none;
    padding: 6px 13px;
    border-radius: var(--r-pill);
    border: 1px solid var(--coral);
    color: var(--coral);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .notice-title {
    font-size: clamp(17px, 2.2vw, 20px);
    margin-bottom: 8px;
  }
  .notice-body p {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.76;
  }
  .notice-body strong {
    color: var(--text);
    font-weight: 700;
  }

  /* ── 반응형 ─────────────────────────────────────────── */

  /* 데스크톱(≥1024px): 넉넉한 에디토리얼 여백 유지 */
  @media (min-width: 1024px) {
    .hero-grid {
      gap: clamp(56px, 6vw, 88px);
    }
  }

  /* 태블릿: 히어로/타깃 세로 스택. 캐릭터를 위로(에디토리얼) */
  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: clamp(28px, 5vw, 44px);
    }
    .hero-visual {
      order: -1;
    }
    .hero-figure {
      max-width: 400px;
    }
  }

  @media (max-width: 560px) {
    .belief-item {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .belief-index {
      font-size: 28px;
    }
  }

  /* 모바일(≤640px): 스크롤 흐름을 위해 헤드라인 먼저, 캐릭터는 그 다음.
     세로 여백·터치 타깃 확대, 타이포 축소, 장식은 절제 */
  @media (max-width: 640px) {
    .hero {
      padding-top: clamp(32px, 9vw, 56px);
    }
    .hero-grid {
      gap: 28px;
    }
    /* 헤드라인 → 캐릭터 순서 */
    .hero-visual {
      order: 0;
    }
    .hero-copy .eyebrow {
      margin-bottom: 14px;
    }
    .hero-title {
      font-size: clamp(30px, 8.5vw, 40px);
      margin-bottom: 20px;
    }
    .hero-lead {
      font-size: 16px;
      line-height: 1.72;
    }
    /* 캐릭터는 화면에 맞게 적당한 크기로, 여백은 그대로 유지 */
    .hero-figure {
      max-width: 340px;
      padding: 28px 24px 22px;
    }
    .hero-figure-img {
      width: clamp(168px, 52vw, 220px);
    }
    /* 줄바꿈 강조 CTA — 터치 타깃 확대 (풀폭) */
    .hero-actions {
      margin-top: 28px;
      gap: 12px;
    }
    .hero-actions :global(a) {
      flex: 1 1 100%;
      justify-content: center;
      text-align: center;
    }
    /* 리스트 세로 리듬 확대 */
    .belief-item {
      padding: 26px 0;
    }
  }

  @media (max-width: 520px) {
    .notice {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
