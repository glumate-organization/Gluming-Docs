---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Credentials from '../components/Credentials.astro';
import Faq from '../components/Faq.astro';
import Layout from '../layouts/Layout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SectionHead from '../components/SectionHead.astro';
import { programImages, screens } from '../lib/assets';
import { kakaoChannel } from '../lib/links';
import { outcomes, showOutcomes } from '../lib/trust';

const title = '글루밍 기업 도입 — 임직원 혈당 습관 관리 프로그램';
const description =
  '센터 방문 없이 휴대폰 하나로. 임직원이 매일의 식사와 걸음에서 혈당 흐름을 살피고 동료와 함께 습관을 만들어 가는 글루밍 기업 프로그램을 소개해요.';

// 왜 글루밍 — 스크롤하면 오른쪽 폰 화면이 단계에 맞춰 바뀐다(스크롤리텔링).
// 생산성·이직률 같은 정량 주장은 하지 않는다. 실제로 앱이 하는 일만.
const tour = [
  {
    en: 'Anywhere',
    title: '센터 방문 없이, 휴대폰 하나로',
    desc: '정해진 시간에 모이지 않아도 돼요. 센서를 붙이면 혈당이, 휴대폰을 들고 다니면 걸음이 저절로 쌓여요. 바쁜 주에도 관리가 끊기지 않아요.',
    points: ['CGM 센서 값 자동 연동', '걸음 수 자동 기록', '한 상을 찰칵 — 음식·탄수화물 자동 인식'],
    img: screens.homeGood,
    alt: '글루밍 홈 화면. 캐릭터가 웃으며 "리듬이 아주 좋아요, 이대로 가요!"라고 알려주고 현재 혈당 109 mg/dL이 크게 보인다.',
  },
  {
    en: 'Everyone',
    title: '누구를 골라내지 않고, 각자의 흐름으로',
    desc: '가볍게 시작하는 분부터 검진 뒤 살펴야 하는 분까지, 같은 앱에서 각자 자기 하루를 봐요. 고위험군만 따로 부르지 않아도 돼요.',
    points: ['혈당 곡선 위에 식사 시각 표시', '먹기 전 혈당실험소로 예상 흐름 보기', '운동별 30분 뒤 흐름 비교'],
    img: screens.dailyLogToday,
    alt: '오늘 기록 화면. 하루 혈당 곡선 위에 점심 식사 시각이 점선으로 표시되고 현재값이 보인다.',
  },
  {
    en: 'Together',
    title: '혼자보다 함께라서, 이어져요',
    desc: '동료를 메이트로 맺으면 서로의 오늘을 글루밍즈 표정으로 먼저 알아요. 잔소리 대신 응원이 오가는 팀 문화가 돼요.',
    points: ['메이트끼리 오늘 컨디션 확인', '"같이 걸을까요?" 응원 한 번에 보내기', '매일 미션 → 포인트로 캐릭터 모으기'],
    img: screens.mateList,
    alt: '메이트 목록 화면. 함께하는 메이트들의 오늘 컨디션과 응원하기 버튼이 카드로 나열돼 있다.',
  },
  {
    en: 'Report',
    title: '참여한 모두에게, 개인별 리포트',
    desc: '프로그램이 끝나면 임직원 한 분 한 분께 각자의 리포트를 보내 드려요. 무엇이 잘 맞았고 다음엔 무엇을 바꿔 볼지, 스스로 고를 수 있게요.',
    points: ['평균 혈당 · 변동성(CV) · 목표 범위 시간(TIR)', '혈당을 많이 올린 끼니 Top 3', '리포트는 본인에게만 — 회사에는 운영 기록만'],
    img: screens.reportGlucose,
    alt: '건강 리포트 혈당 탭. 평균 혈당, 변동성(CV), 목표 범위 시간(TIR), 시간대별 평균 곡선이 정리돼 있다.',
  },
];

// 임직원의 하루 — 실제 앱 화면으로 보는 하루의 흐름 (가로 스크롤)
const day = [
  { time: '08:30', label: '출근길', title: '오늘 컨디션을 표정으로', img: screens.homeToday, alt: '노란 배경의 글루밍 홈 화면. 캐릭터가 "오늘 컨디션 완전 좋아요!"라고 알려준다.' },
  { time: '12:20', label: '점심 전', title: '먹기 전에 흐름 미리 보기', img: screens.labResult, alt: '혈당실험소 예측 결과. 담은 메뉴를 먹었을 때의 예상 혈당 곡선과 상승 폭이 보인다.' },
  { time: '12:30', label: '점심', title: '한 상을 찰칵, 기록 끝', img: screens.mealDetect, alt: '음식 인식 화면. 한 상 사진에서 음식 8개를 각각 찾아 탄수화물과 열량을 정리한다.' },
  { time: '13:10', label: '식후', title: '걸으면 어떻게 될까?', img: screens.simExercise, alt: '운동 시뮬레이션 화면. 빠른 걷기·스쿼트·런닝 뒤 30분 예상 흐름을 비교한다.' },
  { time: '18:40', label: '퇴근길', title: '오늘의 미션 채우기', img: screens.mission, alt: '미션 화면. 식사 기록, 운동 기록, 8,000보 걷기 미션과 포인트가 진행바와 함께 보인다.' },
  { time: '21:00', label: '저녁', title: '동료에게 응원 한마디', img: screens.mateCheer, alt: '응원 메시지 고르기 화면. "오늘도 화이팅이에요!", "같이 걸을까요?" 같은 응원 문구를 고른다.' },
];

const process = [
  { en: 'Recruit', title: '대상자 모집', desc: '참여 범위와 기간을 함께 정하고, 임직원 안내 자료를 준비해 드려요.' },
  { en: 'Onboard', title: '시작 안내', desc: '앱 설치부터 센서 연동, 첫 기록까지 한 번에 따라 할 수 있게 도와드려요.' },
  { en: 'Run', title: '프로그램 운영', desc: '매일의 미션과 메이트 응원으로 참여가 이어지도록 함께 운영해요.' },
  { en: 'Report', title: '개인별 리포트 발행', desc: '참여한 임직원 모두에게 각자의 혈당 흐름·식사·걸음을 정리한 리포트를 보내 드려요.' },
  { en: 'Review', title: '운영 기록 · 결과 리뷰', desc: '참여 현황과 운영 기록을 정리해 전달하고, 다음 단계를 함께 이야기해요.' },
];

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

const faqs = [
  {
    q: '글루밍이 우리 회사에 왜 필요한가요?',
    a: '<p>건강검진 결과지를 받아도 일상은 그대로인 경우가 많아요. 글루밍은 임직원이 매일의 식사와 걸음에서 자기 혈당 흐름을 직접 보고, 생활 속 작은 선택을 바꿔 가도록 돕는 웰니스 프로그램이에요.</p>',
  },
  {
    q: '임직원들이 꾸준히 참여할 수 있을까요?',
    a: '<p>기록은 사진 한 장, 걸음은 자동으로 들어와요. 메이트 응원과 미션, 표정이 바뀌는 글루밍즈 캐릭터가 매일 앱을 여는 이유가 되도록 만들었어요.</p>',
  },
  {
    // 개인 리포트는 본인에게만 전달된다는 전제 — 회사에는 개인 단위 건강 데이터가 아니라 운영 기록만 간다.
    q: '참여한 임직원은 무엇을 받나요?',
    a: '<p>참여한 임직원 한 분 한 분께 <strong>개인별 리포트</strong>를 발행해 드려요. 내 혈당 흐름이 어땠는지, 어떤 끼니 뒤에 많이 올랐는지, 걸음은 얼마나 쌓였는지를 정리해서 다음엔 무엇을 바꿔 볼지 스스로 고를 수 있게 도와요.</p><p>개인 리포트는 본인에게만 전달되고, 회사에는 참여 현황과 운영 기록을 정리해 드려요.</p>',
  },
  {
    q: '실제로 운영한 사례가 있나요?',
    a: '<p>대전광역시와 함께한 장대 웰니스 메이커스 프로그램에서 혈당관리 프로그램을 운영했고, 대상(대전광역시장상)을 받았어요. 자세한 내용은 도입 상담 때 안내해 드릴게요.</p>',
  },
  {
    q: '운영 기록을 건강친화기업 인증 같은 제도에 활용할 수 있나요?',
    a: '<p>프로그램 운영 기록은 정리해서 전달해 드려요. 다만 각 제도에서 어떻게 인정되는지는 제도 기준에 따라 달라서, 도입 상담 때 함께 확인해요.</p>',
  },
  {
    q: '도입 절차와 견적이 궁금해요.',
    a: '<p><a href="' + kakaoChannel + '" target="_blank" rel="noopener noreferrer">카카오톡 채널</a>로 회사 규모와 원하시는 기간을 남겨 주시면, 상담 후 맞춤 견적을 드려요.</p>',
  },
];
---

<Layout title={title} description={description}>
  <!-- 1. HERO -->
  <section class="section hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Gluming for Teams</span>
        <h1 class="hero-title">임직원의 내일을 바꾸는<br />혈당 습관 관리</h1>
        <p class="hero-lead">
          검진 결과지를 받은 뒤에도 일상은 그대로인 경우가 많아요. 글루밍은 임직원이
          <strong>매일의 식사와 걸음에서 혈당 흐름을 살피고</strong>, 동료와 함께 습관을 만들어 가도록 도와요.
          참여한 임직원 모두에게는 <strong>개인별 리포트</strong>를 발행해 드려요.
        </p>
        <div class="hero-actions">
          <Button href={kakaoChannel} size="lg">도입 문의하기</Button>
          <Button href="/program" variant="ghost" size="lg">프로그램 자세히 보기 →</Button>
        </div>
      </div>
      <figure class="hero-figure">
        <Image
          src={programImages.desk}
          alt="햇살 드는 사무실의 나무 책상 위, 닫힌 노트북과 세이지색 텀블러, 접힌 종이 한 장."
          widths={[640, 960, 1400]}
          sizes="(max-width: 900px) 100vw, 55vw"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <!-- 2. 등록·수상 -->
  <section class="creds-sec">
    <div class="container">
      <Credentials />
    </div>
  </section>

  <!-- 3. 왜 글루밍 — 스크롤리텔링 -->
  <section class="section tour-sec">
    <div class="container">
      <SectionHead eyebrow="01 — Why Gluming" variant="split">
        일하는 하루 위에서<br />이어지는 건강관리
        <Fragment slot="sub">
          따로 시간을 내는 프로그램은 바쁜 주에 가장 먼저 밀려나요.<br />
          글루밍은 <strong>원래 하던 식사와 걸음</strong> 위에서 움직여요.
        </Fragment>
      </SectionHead>

      <div class="tour" data-tour>
        <ol class="tour-steps">
          {
            tour.map((t, i) => (
              <li class:list={['tour-step', { 'is-active': i === 0 }]} data-step={i}>
                <p class="tour-en">
                  <span class="tour-num">{String(i + 1).padStart(2, '0')}</span>
                  {t.en}
                </p>
                <h3>{t.title}</h3>
                <p class="tour-desc">{t.desc}</p>
                <ul class="tour-points">
                  {t.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
                <!-- 좁은 화면에서는 단계마다 화면을 바로 아래에 -->
                <div class="tour-inline">
                  <PhoneFrame width={220}>
                    <Image src={t.img} alt={t.alt} widths={[240, 480]} sizes="220px" loading="lazy" />
                  </PhoneFrame>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="tour-stage" aria-hidden="true">
          <div class="tour-phone">
            <PhoneFrame width={300}>
              <div class="tour-screens">
                {
                  tour.map((t, i) => (
                    <Image
                      class:list={['tour-screen', { 'is-active': i === 0 }]}
                      data-screen={i}
                      src={t.img}
                      alt=""
                      widths={[320, 640]}
                      sizes="300px"
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  ))
                }
              </div>
            </PhoneFrame>
            <ol class="tour-dots">
              {tour.map((_, i) => <li class:list={{ 'is-active': i === 0 }} data-dot={i} />)}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. 임직원의 하루 -->
  <section class="section day-sec">
    <div class="container">
      <SectionHead eyebrow="02 — A Day with Gluming" variant="split">
        임직원의 하루는<br />이렇게 흘러가요
        <Fragment slot="sub">
          출근길부터 저녁까지, 따로 시간을 내지 않아도<br />
          <strong>하루 몇 번의 터치</strong>로 관리가 이어져요.
        </Fragment>
      </SectionHead>
    </div>
    <ol class="day-track" tabindex="0" aria-label="임직원의 하루 — 옆으로 넘겨 보세요">
      {
        day.map((d, i) => (
          <li class="day-card" style={`--i:${i}`}>
            <p class="day-time">
              <span>{d.time}</span>
              {d.label}
            </p>
            <div class="day-shot">
              <Image src={d.img} alt={d.alt} widths={[260, 520]} sizes="240px" loading="lazy" />
            </div>
            <p class="day-title">{d.title}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- 5. 진행 방식 -->
  <section class="section process">
    <div class="container">
      <SectionHead eyebrow="03 — How it works">
        도입부터 결과 리뷰까지, 글루밍이 함께해요
      </SectionHead>
      <ol class="flow">
        {
          process.map((p, i) => (
            <li class="flow-step" style={`--i:${i}`}>
              <span class="flow-dot">{String(i + 1).padStart(2, '0')}</span>
              <p class="flow-en">{p.en}</p>
              <h3>{p.title}</h3>
              <p class="flow-desc">{p.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. 프로그램 성과 — outcomes.verified 전에는 개발 서버에서만 렌더 -->
  {
    showOutcomes && (
      <section class="section results">
        <div class="container">
          <SectionHead eyebrow="04 — Results" variant="split">
            {outcomes.program}
            <Fragment slot="sub">참여자의 프로그램 전후 변화예요.</Fragment>
          </SectionHead>
          {!outcomes.verified && (
            <p class="dev-flag" role="note">
              개발 화면 전용 · 임시값이에요. src/lib/trust.ts 에서 실제 값을 넣고 verified 를 true 로 바꾸면 공개돼요.
            </p>
          )}
          <dl class="result-grid">
            {outcomes.items.map((it) => (
              <div class="result reveal">
                <dt>{it.label}</dt>
                <dd>
                  <span class="r-before">
                    {fmt(it.before)}
                    <small>{it.unit}</small>
                  </span>
                  <span class="r-arrow" aria-label="에서">→</span>
                  <span class="r-after">
                    {fmt(it.after)}
                    <small>{it.unit}</small>
                  </span>
                </dd>
              </div>
            ))}
          </dl>
          <p class="result-note">{outcomes.note}</p>
        </div>
      </section>
    )
  }

  <!-- 7. FAQ -->
  <section class="section faq-sec">
    <div class="container">
      <SectionHead eyebrow="FAQ">자주 묻는 질문</SectionHead>
      <Faq items={faqs} />
    </div>
  </section>

  <!-- 8. CTA -->
  <section class="section cta">
    <div class="container">
      <div class="cta-band">
        <p class="eyebrow on-dark">Talk to us</p>
        <h2 class="cta-title">우리 회사에 맞는 방법,<br />같이 찾아볼까요?</h2>
        <p class="cta-sub">회사 규모와 원하시는 기간을 남겨 주시면, 담당자가 편하게 안내해 드릴게요.</p>
        <div class="cta-actions">
          <Button href={kakaoChannel} size="lg">카카오톡으로 도입 문의하기</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // 왜 글루밍 스크롤리텔링 — 화면 가운데를 지나는 단계를 활성으로 표시하고, 오른쪽 폰 화면·점·진행선을 맞춘다.
  // 외부 의존 없이 IntersectionObserver + scroll 한 개. JS 가 없으면 첫 화면이 고정된 채 모든 글이 보인다.
  const tour = document.querySelector<HTMLElement>('[data-tour]');
  if (tour) {
    const steps = [...tour.querySelectorAll<HTMLElement>('[data-step]')];
    const screens = [...tour.querySelectorAll<HTMLElement>('[data-screen]')];
    const dots = [...tour.querySelectorAll<HTMLElement>('[data-dot]')];
    const list = tour.querySelector<HTMLElement>('.tour-steps')!;
    tour.classList.add('is-live');

    const activate = (i: number) => {
      [steps, screens, dots].forEach((group) =>
        group.forEach((el, j) => el.classList.toggle('is-active', i === j))
      );
    };
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
        });
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );
    steps.forEach((s) => io.observe(s));

    // 진행선: 단계 목록의 위끝이 화면 가운데에 닿을 때 0, 아래끝이 닿을 때 1
    const onScroll = () => {
      const r = list.getBoundingClientRect();
      const mid = innerHeight / 2;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      list.style.setProperty('--tour-progress', p.toFixed(3));
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

