---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Faq from '../components/Faq.astro';
import Layout from '../layouts/Layout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SectionHead from '../components/SectionHead.astro';
import { programImages, screens } from '../lib/assets';
import { kakaoChannel } from '../lib/links';
import { credentials, outcomes, showOutcomes } from '../lib/trust';

const title = '글루밍 기업 도입 — 임직원 혈당 습관 관리 프로그램';
const description =
  '센터 방문 없이 휴대폰 하나로. 임직원이 매일의 식사와 걸음에서 혈당 흐름을 살피고 동료와 함께 습관을 만들어 가는 글루밍 기업 프로그램을 소개해요.';

// 가치 — 생산성·이직률 같은 정량 주장은 하지 않는다. 실제로 앱이 하는 일만.
const values = [
  {
    title: '센터 방문 없이, 휴대폰 하나로',
    desc: '정해진 시간에 모이지 않아도 돼요. 점심 한 끼, 퇴근길 걸음처럼 원래 하던 일 위에서 관리가 이어져요.',
    img: screens.homeGood,
    alt: '글루밍 홈 화면. 캐릭터가 웃으며 "리듬이 아주 좋아요, 이대로 가요!"라고 알려주고 현재 혈당이 크게 보인다.',
  },
  {
    title: '가볍게 시작하는 분부터, 검진 뒤 살펴야 하는 분까지',
    desc: '같은 앱 안에서 각자 자기 흐름을 봐요. 누구를 골라내지 않고, 원하는 임직원 모두가 함께할 수 있어요.',
    img: screens.dailyLogToday,
    alt: '오늘 기록 화면. 하루 혈당 곡선 위에 식사 마커와 현재값이 표시된다.',
  },
  {
    title: '혼자보다 함께라서, 이어져요',
    desc: '동료를 메이트로 맺고 응원을 톡 보내요. 미션과 글루밍즈 캐릭터가 매일 앱을 여는 작은 이유가 돼요.',
    img: screens.mateList,
    alt: '메이트 목록 화면. 함께하는 메이트들의 오늘 컨디션과 응원하기 버튼이 보인다.',
  },
];

const process = [
  { en: 'Recruit', title: '대상자 모집', desc: '참여 범위와 기간을 함께 정하고, 임직원 안내를 도와드려요.' },
  { en: 'Run', title: '프로그램 운영', desc: '앱 설치부터 센서 연동, 첫 기록까지 글루밍이 함께해요.' },
  { en: 'Report', title: '개인별 리포트 발행', desc: '참여한 임직원 모두에게 각자의 혈당 흐름·식사·걸음을 정리한 개인 리포트를 보내 드려요.' },
  { en: 'Review', title: '운영 기록 · 결과 리뷰', desc: '참여 현황과 운영 기록을 정리해 전달하고, 담당자와 함께 다음 단계를 이야기해요.' },
];

const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));

const faqs = [
  {
    q: '글루밍이 우리 회사에 왜 필요한가요?',
    a: '<p>건강검진 결과지를 받아도 일상은 그대로인 경우가 많아요. 글루밍은 임직원이 매일의 식사와 걸음에서 자기 혈당 흐름을 직접 보고, 생활 속 작은 선택을 바꿔 가도록 돕는 웰니스 프로그램이에요.</p>',
  },
  {
    q: '임직원들이 꾸준히 참여할 수 있을까요?',
    a: '<p>기록은 사진 한 장, 걸음은 자동으로 들어와요. 메이트 응원과 미션, 표정이 바뀌는 글루밍즈 캐릭터가 매일 앱을 여는 이유가 되도록 만들었어요.</p>',
  },
  {
    // 개인 리포트는 본인에게만 전달된다는 전제 — 회사에는 개인 단위 건강 데이터가 아니라 운영 기록만 간다.
    q: '참여한 임직원은 무엇을 받나요?',
    a: '<p>참여한 임직원 한 분 한 분께 <strong>개인별 리포트</strong>를 발행해 드려요. 내 혈당 흐름이 어땠는지, 어떤 끼니 뒤에 많이 올랐는지, 걸음은 얼마나 쌓였는지를 정리해서 다음엔 무엇을 바꿔 볼지 스스로 고를 수 있게 도와요.</p><p>개인 리포트는 본인에게만 전달되고, 회사에는 참여 현황과 운영 기록을 정리해 드려요.</p>',
  },
  {
    q: '실제로 운영한 사례가 있나요?',
    a: '<p>대전광역시와 함께한 장대 웰니스 메이커스 프로그램에서 혈당관리 프로그램을 운영했고, 대상(대전광역시장상)을 받았어요. 자세한 내용은 도입 상담 때 안내해 드릴게요.</p>',
  },
  {
    q: '운영 기록을 건강친화기업 인증 같은 제도에 활용할 수 있나요?',
    a: '<p>프로그램 운영 기록은 정리해서 전달해 드려요. 다만 각 제도에서 어떻게 인정되는지는 제도 기준에 따라 달라서, 도입 상담 때 함께 확인해요.</p>',
  },
  {
    q: '도입 절차와 견적이 궁금해요.',
    a: '<p><a href="' + kakaoChannel + '" target="_blank" rel="noopener noreferrer">카카오톡 채널</a>로 회사 규모와 원하시는 기간을 남겨 주시면, 상담 후 맞춤 견적을 드려요.</p>',
  },
];
---

<Layout title={title} description={description}>
  <!-- 1. HERO -->
  <section class="section hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Gluming for Teams</span>
        <h1 class="hero-title">임직원의 내일을 바꾸는<br />혈당 습관 관리</h1>
        <p class="hero-lead">
          검진 결과지를 받은 뒤에도 일상은 그대로인 경우가 많아요. 글루밍은 임직원이
          <strong>매일의 식사와 걸음에서 혈당 흐름을 살피고</strong>, 동료와 함께 습관을 만들어 가도록 도와요.
          참여한 임직원 모두에게는 <strong>개인별 리포트</strong>를 발행해 드려요.
        </p>
        <div class="hero-actions">
          <Button href={kakaoChannel} size="lg">도입 문의하기</Button>
          <Button href="/program" variant="ghost" size="lg">프로그램 자세히 보기 →</Button>
        </div>
      </div>
      <figure class="hero-figure">
        <Image
          src={programImages.desk}
          alt="햇살 드는 사무실의 나무 책상 위, 닫힌 노트북과 세이지색 텀블러, 접힌 종이 한 장."
          widths={[640, 960, 1400]}
          sizes="(max-width: 900px) 100vw, 55vw"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <!-- 2. 등록·수상 -->
  <section class="trust">
    <div class="container">
      <ul class="cred-list">
        {
          credentials.map((c) => (
            <li class="cred">
              <span class="cred-kicker">{c.kicker}</span>
              <span class="cred-title">{c.title}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. 가치 -->
  <section class="section values">
    <div class="container">
      <SectionHead eyebrow="01 — Why Gluming" variant="split">
        일하는 하루 위에서<br />이어지는 건강관리
        <Fragment slot="sub">
          따로 시간을 내는 프로그램은 바쁜 주에 가장 먼저 밀려나요.<br />
          글루밍은 <strong>원래 하던 식사와 걸음</strong> 위에서 움직여요.
        </Fragment>
      </SectionHead>

      {
        values.map((v, i) => (
          <article class:list={['value', 'reveal', { 'value-reverse': i % 2 === 1 }]}>
            <div class="value-text">
              <span class="cell-index">{String(i + 1).padStart(2, '0')}</span>
              <h3>{v.title}</h3>
              <p>{v.desc}</p>
            </div>
            <div class="value-media">
              <PhoneFrame width={230}>
                <Image src={v.img} alt={v.alt} widths={[260, 520]} sizes="230px" loading="lazy" />
              </PhoneFrame>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 4. 진행 방식 -->
  <section class="section process">
    <div class="container">
      <SectionHead eyebrow="02 — How it works">
        도입부터 결과 리뷰까지, 글루밍이 함께해요
      </SectionHead>
      <ol class="cells process-cells">
        {
          process.map((p, i) => (
            <li class="cell reveal">
              <span class="cell-index">{String(i + 1).padStart(2, '0')} · {p.en}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. 프로그램 성과 — outcomes.verified 전에는 개발 서버에서만 렌더 -->
  {
    showOutcomes && (
      <section class="section results">
        <div class="container">
          <SectionHead eyebrow="03 — Results" variant="split">
            {outcomes.program}
            <Fragment slot="sub">참여자의 프로그램 전후 변화예요.</Fragment>
          </SectionHead>
          {!outcomes.verified && (
            <p class="dev-flag" role="note">
              개발 화면 전용 · 임시값이에요. src/lib/trust.ts 에서 실제 값을 넣고 verified 를 true 로 바꾸면 공개돼요.
            </p>
          )}
          <dl class="result-grid">
            {outcomes.items.map((it) => (
              <div class="result reveal">
                <dt>{it.label}</dt>
                <dd>
                  <span class="r-before">
                    {fmt(it.before)}
                    <small>{it.unit}</small>
                  </span>
                  <span class="r-arrow" aria-label="에서">→</span>
                  <span class="r-after">
                    {fmt(it.after)}
                    <small>{it.unit}</small>
                  </span>
                </dd>
              </div>
            ))}
          </dl>
          <p class="result-note">{outcomes.note}</p>
        </div>
      </section>
    )
  }

  <!-- 6. FAQ -->
  <section class="section faq-sec">
    <div class="container">
      <SectionHead eyebrow="FAQ">자주 묻는 질문</SectionHead>
      <Faq items={faqs} />
    </div>
  </section>

  <!-- 7. CTA -->
  <section class="section cta">
    <div class="container">
      <div class="cta-band">
        <p class="eyebrow on-dark">Talk to us</p>
        <h2 class="cta-title">우리 회사에 맞는 방법,<br />같이 찾아볼까요?</h2>
        <p class="cta-sub">회사 규모와 원하시는 기간을 남겨 주시면, 담당자가 편하게 안내해 드릴게요.</p>
        <div class="cta-actions">
          <Button href={kakaoChannel} size="lg">카카오톡으로 도입 문의하기</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero {
    padding-top: clamp(48px, 7vw, 96px);
    padding-bottom: clamp(40px, 5vw, 64px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-title {
    font-size: var(--fs-h1);
    line-height: var(--lh-title);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .hero-lead {
    margin-top: var(--sp-5);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.78;
    max-width: 560px;
  }
  .hero-lead strong {
    color: var(--text);
    font-weight: 700;
  }
  .hero-actions {
    margin-top: var(--sp-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }
  .hero-figure {
    margin: 0;
    aspect-ratio: 3 / 2;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--card-soft);
  }
  .hero-figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── 등록·수상 ── */
  .cred-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .cred {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-6) var(--sp-5);
    border-left: 1px solid var(--rule);
  }
  .cred:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .cred-kicker {
    color: var(--text-3);
    font-size: var(--fs-sm);
  }
  .cred-title {
    font-size: var(--fs-h4);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }

  /* ── 가치 ── 글 + 실제 화면 교차 */
  .value {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    padding: clamp(40px, 6vw, 72px) 0;
    border-top: 1px solid var(--rule);
  }
  .value-reverse {
    grid-template-columns: 0.8fr 1.2fr;
  }
  .value-reverse .value-media {
    order: -1;
  }
  .value-media {
    display: flex;
    justify-content: center;
  }
  .value h3 {
    margin-top: var(--sp-3);
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
    line-height: var(--lh-title);
    text-wrap: balance;
  }
  .value p {
    margin-top: var(--sp-4);
    max-width: 520px;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.78;
  }

  /* ── 진행 방식 ── */
  .process-cells {
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(4, 1fr);
  }
  .process-cells h3 {
    margin-top: var(--sp-5);
    font-size: var(--fs-h3);
    letter-spacing: -0.03em;
  }
  .process-cells p {
    margin-top: var(--sp-3);
    color: var(--text-2);
    line-height: var(--lh-body);
  }

  /* ── 성과 ── */
  .dev-flag {
    margin-bottom: var(--sp-5);
    padding: var(--sp-3) var(--sp-4);
    border: 1px dashed var(--coral);
    border-radius: var(--r-sm);
    color: var(--coral);
    font-size: var(--fs-sm);
  }
  .result-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    border-top: 1px solid var(--text);
  }
  .result {
    padding: var(--sp-6) var(--sp-5) var(--sp-7) 0;
    border-bottom: 1px solid var(--rule);
  }
  .result dt {
    color: var(--text-2);
    font-weight: 600;
  }
  .result dd {
    margin: var(--sp-4) 0 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-3);
    font-family: var(--font-serif);
  }
  .result small {
    margin-left: 2px;
    font-family: var(--font-sans, inherit);
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
  .r-before {
    font-size: var(--fs-h3);
    color: var(--text-3);
  }
  .r-arrow {
    color: var(--text-3);
  }
  .r-after {
    font-size: var(--fs-display);
    line-height: 1;
    color: var(--pine);
  }
  .result-note {
    margin-top: var(--sp-4);
    color: var(--text-3);
    font-size: var(--fs-xs);
  }

  /* ── CTA 밴드 ── */
  .cta-band {
    position: relative;
    background: var(--pine);
    color: var(--on-dark);
    border-radius: var(--r-lg);
    padding: clamp(48px, 7vw, 88px) clamp(24px, 5vw, 64px);
    overflow: hidden;
    isolation: isolate;
  }
  .cta-band::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--grain);
    background-size: 180px 180px;
    opacity: 0.07;
    pointer-events: none;
  }
  .eyebrow.on-dark {
    color: var(--primary-light);
  }
  .cta-title {
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
    line-height: var(--lh-title);
    color: var(--on-dark);
  }
  .cta-sub {
    margin: var(--sp-5) 0 var(--sp-7);
    max-width: 520px;
    color: color-mix(in srgb, var(--on-dark) 78%, transparent);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .cta-band :global(.btn-primary) {
    background: var(--on-dark);
    color: var(--pine);
  }
  .cta-band :global(.btn-primary:hover) {
    background: var(--surface);
  }

  /* ── 반응형 ── */
  @media (max-width: 1023px) {
    .process-cells {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 900px) {
    .hero-grid,
    .value,
    .value-reverse {
      grid-template-columns: 1fr;
    }
    .value-reverse .value-media {
      order: 0;
    }
    .result-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero-actions :global(a) {
      width: 100%;
      justify-content: center;
    }
    .cred-list,
    .process-cells {
      grid-template-columns: 1fr;
    }
    .cred {
      border-left: 0;
      border-top: 1px solid var(--rule);
      padding-inline: 0;
    }
    .cred:first-child {
      border-top: 0;
    }
  }
</style>
