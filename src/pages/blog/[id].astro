---
// 혈당 노트 — 글 하나. 본문 타이포는 정책 문서와 같은 LegalDoc 을 재사용한다 (좁은 읽기 폭·헤어라인).
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import LegalDoc from '../../components/LegalDoc.astro';
import { SITE_URL, blogPostingSchema, postBreadcrumbSchema } from '../../lib/seo';
import { formatDate, getPublishedPosts, isoDate, postPath, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // posts 는 최신순 → 이전 글 = 한 칸 더 오래된 글, 다음 글 = 한 칸 더 최신 글
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, prev: posts[i + 1], next: posts[i - 1] },
  }));
}

const { post, prev, next } = Astro.props as { post: Post; prev?: Post; next?: Post };
const { Content } = await render(post);
const d = post.data;
const url = `${SITE_URL}${postPath(post)}`;
const modified = d.updatedDate ?? d.publishDate;
// 대표 이미지가 있으면 공유 미리보기(og:image)·JSON-LD 도 그 이미지로 (1200px jpg — SNS 가 webp/svg 를 못 읽는 경우 대비)
const ogImage = d.cover
  ? new URL((await getImage({ src: d.cover, width: 1200, format: 'jpg' })).src, SITE_URL).href
  : undefined;
---

<Layout
  title={`${d.title} — 글루밍 혈당 노트`}
  description={d.description}
  ogImage={ogImage}
  jsonLd={[
    blogPostingSchema({
      url,
      title: d.title,
      description: d.description,
      published: isoDate(d.publishDate),
      modified: isoDate(modified),
      section: d.category,
      author: d.author,
      sources: d.sources,
      image: ogImage,
    }),
    postBreadcrumbSchema(url, d.title),
  ]}
>
  <LegalDoc
    eyebrow={`Journal · ${d.category}`}
    title={d.title}
    lead={d.description}
  >
    <p class="post-meta" slot="meta">
      <span>{d.author}</span>
      <span class="dot" aria-hidden="true">·</span>
      <time datetime={isoDate(d.publishDate)}>{formatDate(d.publishDate)}</time>
      {
        d.updatedDate && (
          <>
            <span class="dot" aria-hidden="true">·</span>
            <span>
              <time datetime={isoDate(d.updatedDate)}>{formatDate(d.updatedDate)}</time> 업데이트
            </span>
          </>
        )
      }
    </p>

    {
      d.cover && (
        <figure class="post-cover">
          <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[680, 1360]} sizes="(max-width: 728px) 100vw, 680px" loading="eager" />
        </figure>
      )
    }

    <div class="post-body">
      <Content />
    </div>

    <h2>참고한 자료</h2>
    <ol class="sources">
      {
        d.sources.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a>
          </li>
        ))
      }
    </ol>

    <div class="notice post-promo">
      <p>
        글루밍에서는 식사나 운동을 고르기 전에, 내 혈당 흐름이 어떻게 달라질지 미리 그려볼 수 있어요.
      </p>
      <p class="post-cta"><a href="/program/">글루밍 프로그램 둘러보기 →</a></p>
    </div>

    <nav class="post-pager" aria-label="이전 글, 다음 글">
      {
        prev ? (
          <a href={postPath(prev)} rel="prev" class="pager-link pager-prev">
            <span class="pager-label">← 이전 글</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={postPath(next)} rel="next" class="pager-link pager-next">
            <span class="pager-label">다음 글 →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
    <p><a href="/blog/">← 혈당 노트 목록</a></p>
  </LegalDoc>
</Layout>

<style>
  .post-meta {
    margin-top: var(--sp-5);
    color: var(--text-3);
    font-size: var(--fs-sm);
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .post-meta .dot {
    color: var(--rule);
  }
  .post-cta {
    margin-bottom: 0;
  }
  /* 이전·다음 글 — 헤어라인 사이 2열. 최신 쪽(다음 글)은 오른쪽 정렬 */
  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    margin: var(--sp-7) 0 var(--sp-5);
    padding: var(--sp-5) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .post-pager .pager-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: var(--text);
  }
  .post-pager .pager-next {
    text-align: right;
  }
  .pager-label {
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
  .pager-title {
    font-weight: 600;
    line-height: 1.5;
    transition: color 0.18s ease;
  }
  .pager-link:hover .pager-title {
    color: var(--sage-dark);
  }
  @media (max-width: 560px) {
    .post-pager {
      grid-template-columns: 1fr;
    }
    .post-pager .pager-next {
      text-align: left;
    }
    /* 이전 글이 없는 첫 글에서 빈 칸이 남지 않게 */
    .post-pager > span:empty {
      display: none;
    }
  }
  /* 앱 웹뷰(?app=1)에서는 웹 프로그램 안내를 숨긴다 */
  :global(html[data-app]) .post-promo {
    display: none;
  }
  .post-cover {
    margin: 0 0 var(--sp-7);
  }
  .post-cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
  }
  /* 본문 이미지 — Markdown 의 ![설명](경로). 바로 다음 줄의 *기울임* 문단은 캡션처럼 보인다.
     세로로 긴 앱 화면도 화면을 다 덮지 않도록 높이를 제한한다. */
  .post-body :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 560px;
    height: auto;
    margin: var(--sp-6) auto var(--sp-3);
    border-radius: var(--r-lg);
    border: 1px solid var(--rule);
  }
  .post-body :global(p:has(> img) + p > em:only-child) {
    display: block;
    text-align: center;
    font-style: normal;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
</style>
