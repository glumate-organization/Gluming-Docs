---
// 혈당 노트 — 글 목록. 새 글은 src/content/blog/ 에 .md 를 추가하면 자동으로 여기 올라온다.
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { BLOG_DESCRIPTION, BLOG_TITLE, formatDate, getPublishedPosts, isoDate, postPath } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<Layout title={`${BLOG_TITLE} — 글루밍`} description={BLOG_DESCRIPTION}>
  <section class="blog">
    <header class="blog-head container">
      <p class="blog-eyebrow">Journal</p>
      <h1 class="blog-title">{BLOG_TITLE}</h1>
      <p class="blog-lead">{BLOG_DESCRIPTION}</p>
    </header>

    <div class="container">
      {
        posts.length === 0 ? (
          <p class="blog-empty">첫 글을 준비하고 있어요.</p>
        ) : (
          <ul class="post-list">
            {posts.map((p) => (
              <li class="post-item">
                <a href={postPath(p)} class:list={['post-link', { 'has-thumb': p.data.cover }]}>
                  {p.data.cover && (
                    <Image src={p.data.cover} alt="" class="post-thumb" widths={[200, 400]} sizes="200px" />
                  )}
                  <div class="post-text">
                    <p class="post-kicker">
                      <span class="post-cat">{p.data.category}</span>
                      <time datetime={isoDate(p.data.publishDate)}>{formatDate(p.data.publishDate)}</time>
                    </p>
                    <h2 class="post-title">{p.data.title}</h2>
                    <p class="post-desc">{p.data.description}</p>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>

<style>
  .blog {
    padding-top: var(--sp-9);
    padding-bottom: var(--section-y);
  }
  .container {
    width: min(var(--measure), calc(100% - 48px));
    margin-inline: auto;
  }
  .blog-head {
    padding-bottom: var(--sp-7);
    margin-bottom: var(--sp-4);
    border-bottom: 1px solid var(--rule);
  }
  .blog-eyebrow {
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sage-dark);
    margin-bottom: var(--sp-4);
  }
  .blog-title {
    font-size: var(--fs-h1);
    letter-spacing: -0.04em;
    line-height: var(--lh-title);
  }
  .blog-lead {
    margin-top: var(--sp-5);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .blog-empty {
    padding: var(--sp-8) 0;
    color: var(--text-3);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-item {
    border-bottom: 1px solid var(--rule);
  }
  .post-link {
    display: block;
    padding: var(--sp-6) 0;
    color: inherit;
  }
  .post-link.has-thumb {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: var(--sp-5);
    align-items: center;
  }
  .post-link.has-thumb :global(.post-thumb) {
    order: 2;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--r-md);
  }
  @media (max-width: 560px) {
    .post-link.has-thumb {
      grid-template-columns: 1fr;
    }
    .post-link.has-thumb :global(.post-thumb) {
      order: 0;
    }
  }
  .post-kicker {
    display: flex;
    gap: var(--sp-3);
    align-items: center;
    font-size: var(--fs-xs);
    color: var(--text-3);
  }
  .post-cat {
    padding: 2px var(--sp-2);
    border-radius: var(--r-pill);
    background: var(--primary-bg);
    color: var(--sage-dark);
    font-weight: 600;
  }
  .post-title {
    margin-top: var(--sp-3);
    font-size: var(--fs-h3);
    letter-spacing: -0.03em;
    line-height: var(--lh-title);
    transition: color var(--dur-1) var(--ease);
  }
  .post-link:hover .post-title {
    color: var(--sage-dark);
  }
  .post-desc {
    margin-top: var(--sp-3);
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
</style>
