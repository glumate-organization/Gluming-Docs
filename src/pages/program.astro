---
import { Image } from 'astro:assets';
import CharacterCard from '../components/CharacterCard.astro';
import Credentials from '../components/Credentials.astro';
import Faq from '../components/Faq.astro';
import Layout from '../layouts/Layout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SectionHead from '../components/SectionHead.astro';
import Sprout from '../components/Sprout.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { characters, programImages, screens } from '../lib/assets';
import { kakaoChannel } from '../lib/links';
import { mobileAppSchema } from '../lib/seo';

const title = '글루밍 프로그램 — 혈당 흐름으로 시작하는 다이어트·건강관리';
const description =
  '굶지 않고, 참지 않고. 연구로 알려진 혈당의 원리를 매일의 식사·걷기로 옮긴 글루밍의 다이어트·건강관리 프로그램을 소개해요.';

// 원리 — 숫자 없이 방향만. 출처는 아래 sources 줄에 모아 단다.
const principles = [
  {
    title: '같은 한 끼도, 몸마다 다르게 답해요',
    desc: '같은 음식을 먹어도 식후 혈당이 오르내리는 모양은 사람마다 다르다는 연구가 있어요. 그래서 남의 식단표보다 내 몸의 흐름을 먼저 보는 게 중요해요.',
  },
  {
    title: '무엇을 먼저 먹느냐도 흐름을 바꿔요',
    desc: '채소와 단백질을 먼저, 탄수화물을 나중에 먹으면 식후 혈당 흐름이 달라질 수 있다는 연구가 있어요. 메뉴를 끊는 대신 순서를 바꿔 보는 거예요.',
  },
  {
    title: '먹은 뒤의 짧은 걸음이 도움이 돼요',
    desc: '식사 뒤 가볍게 걷는 습관이 식후 혈당 흐름을 완만하게 하는 데 도움이 된다는 연구들이 있어요. 거창한 운동보다 문 앞 10분부터예요.',
  },
];

const sources = [
  { label: 'Zeevi D, et al. Cell, 2015', url: 'https://doi.org/10.1016/j.cell.2015.11.001' },
  { label: 'Shukla AP, et al. Diabetes Care, 2015', url: 'https://doi.org/10.2337/dc15-0429' },
  { label: 'Reynolds AN, et al. Diabetologia, 2016', url: 'https://doi.org/10.1007/s00125-016-4085-2' },
  { label: 'Buffey AJ, et al. Sports Medicine, 2022', url: 'https://doi.org/10.1007/s40279-022-01649-4' },
];

// 프로그램 흐름 — 각 단계는 실제 앱 화면과 짝지어 아코디언으로. 첫 단계만 펼쳐 둔다.
const steps = [
  {
    en: 'Measure',
    title: '센서를 붙이면, 흐름이 쌓여요',
    desc: 'CGM 센서를 연동하면 하루의 혈당 흐름이 자동으로 차곡차곡 쌓여요. 손끝을 찌르지 않아도 지금 내 몸의 리듬을 볼 수 있어요.',
    img: screens.glucoseDetailDay,
    alt: '혈당 상세 화면. 하루 혈당 곡선과 시간대별 기록 타임라인이 보인다.',
  },
  {
    en: 'Snap',
    title: '찰칵 한 번으로 한 끼를 기록해요',
    desc: '한 상을 찍으면 음식과 탄수화물을 알아서 찾아내요. 기록이 숙제가 되지 않아야 오래 가니까요.',
    img: screens.mealDetect,
    alt: '음식 인식 화면. 한 상 사진에서 음식 8개를 각각 잡아내고 총 탄수화물과 열량을 정리해 보여준다.',
  },
  {
    en: 'Simulate',
    title: '먹기 전에, 흐름을 미리 그려봐요',
    desc: '혈당실험소에 먹으려는 음식을 담으면 내 데이터를 바탕으로 예상 흐름을 보여드려요. 고르는 건 언제나 나예요.',
    img: screens.labResult,
    alt: '혈당실험소 예측 결과 화면. 담은 음식을 먹었을 때의 예상 혈당 흐름이 그래프로 보인다.',
  },
  {
    en: 'Move',
    title: '먹은 뒤엔, 가볍게 움직여요',
    desc: '빠른 걷기·스쿼트·런닝 뒤 30분 흐름을 나란히 견줘 보고, 마음에 드는 걸 바로 해봐요. 걸음 수는 자동으로 들어와요.',
    img: screens.simExercise,
    alt: '“어떤 운동을 해볼까요?” 화면. 운동별 30분 뒤 예상 변화를 점선 기준선과 함께 비교해 보여준다.',
  },
  {
    en: 'Look back',
    title: '쌓인 기록으로, 나에게 맞는 방법을 찾아요',
    desc: '리포트에서 어떤 끼니가 얼마나 올렸는지, 다음엔 어떤 순서로 먹으면 좋을지 돌아봐요. 정답은 남의 식단이 아니라 내 기록에 있어요.',
    img: screens.reportMealDetail,
    alt: '건강 리포트의 끼니 상세. 식후 혈당 상승 폭과 먹는 순서에 대한 안내가 보인다.',
  },
  {
    en: 'Together',
    title: '혼자가 아니라, 함께 해요',
    desc: '가족·메이트와 서로의 오늘을 살피고 응원을 톡 보내요. 글루밍즈 친구들도 표정으로 곁을 지켜요.',
    img: screens.mateCheer,
    alt: '응원 메시지 고르기 화면. 메이트에게 보낼 응원 문구를 고르는 모습.',
  },
];

// 오래 가는 변화 — 의학적 효과가 아니라 생활의 변화로만 말한다. 큰 컷 1 + 작은 컷 2.
const changes = [
  {
    img: programImages.walkKit,
    alt: '저녁빛 드는 나무 벤치 위에 개어 둔 세이지색 바람막이, 흰 물병, 열쇠 꾸러미.',
    kicker: '걷는 습관',
    title: '식후 10분, 걷는 일이 하루의 리듬이 돼요',
    desc: '운동을 결심하는 대신, 밥 먹고 신발을 신는 일부터. 매일 쌓인 걸음이 내 흐름에 어떻게 닿는지 글루밍이 보여드려요.',
  },
  {
    img: programImages.fruit,
    alt: '도자기 그릇에 담긴 사과 하나, 포도 한 송이, 귤 하나.',
    kicker: '식사 리듬',
    title: '끊는 식단 대신, 고르는 식사',
    desc: '참고 굶는 다이어트는 오래가기 어려워요. 순서와 양을 고르는 작은 선택이 쌓여요.',
  },
  {
    img: programImages.tape,
    alt: '둥글게 감긴 크림색 줄자.',
    kicker: '내 몸 이해하기',
    title: '숫자는 천천히, 습관은 오늘부터',
    desc: '체중계 숫자보다 먼저 내 몸이 무엇에 어떻게 답하는지 알게 돼요. 그게 오래 가는 변화의 시작이에요.',
  },
];

const faqs = [
  {
    q: '누구에게 맞는 프로그램인가요?',
    a: '<p>식단·체중 관리를 혈당 흐름으로 시작해 보고 싶은 분, 건강검진에서 혈당 이야기를 들은 분, 임신 중 혈당을 살피고 계신 분께 맞춰 만들었어요. 임신 중이시라면 담당 의료진의 안내를 먼저 따라 주세요.</p><p>1형 당뇨는 대상이 아니에요. 약을 드시고 있다면 식단이나 운동을 바꾸기 전에 담당 의료진과 먼저 상의해 주세요.</p>',
  },
  {
    q: '다이어트에 왜 혈당을 보나요?',
    a: '<p>식후 혈당 흐름은 무엇을, 어떤 순서로 먹었는지, 먹고 나서 움직였는지에 따라 달라져요. 그 흐름을 눈으로 보면 막연히 참는 대신 내 몸에 맞는 선택을 찾기 쉬워져요.</p><p>글루밍은 습관을 돕는 도구이고, 특정한 체중 변화를 약속하지는 않아요.</p>',
  },
  {
    q: 'CGM 센서는 불편하지 않나요?',
    a: '<p>동전만 한 센서를 팔 뒤쪽에 붙여 사용해요. 붙였을 때의 느낌은 사람마다 달라서, 처음에는 제품 안내를 따라 천천히 붙여 주세요. 센서 관련 문의는 <a href="' + kakaoChannel + '" target="_blank" rel="noopener noreferrer">카카오톡 채널</a>로 편하게 남겨 주세요.</p>',
  },
  {
    q: '어떻게 시작하나요?',
    a: '<p>앱을 내려받고, 센서를 연동하고, 첫 끼를 찰칵 찍으면 시작이에요. 며칠만 쌓여도 내 흐름이 조금씩 보이기 시작해요.</p>',
  },
  {
    q: '의료 서비스인가요?',
    a: '<p>아니요. 글루밍은 생활습관 관리를 돕는 웰니스 서비스예요. 건강 관련 판단은 전문가와 상의해 주세요. 앱에서 쓰는 기준과 출처는 <a href="/medical">의료 정보 기준·출처</a>에 정리해 두었어요.</p>',
  },
];
---

<Layout title={title} description={description} jsonLd={[mobileAppSchema()]}>
  <!-- 1. HERO — 문구 + 오브젝트 컷 -->
  <section class="section hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">The Gluming Program</span>
        <h1 class="hero-title">굶지 않고, 참지 않고<br />혈당 흐름으로 시작하는 건강관리</h1>
        <p class="hero-lead">
          글루밍은 연구로 알려진 혈당의 원리를 매일의 식사와 걸음으로 옮긴
          <strong>다이어트·건강관리 프로그램</strong>이에요. 무엇을 끊을지보다, 내 몸이 어떻게 답하는지부터 살펴봐요.
        </p>
        <div class="hero-actions">
          <StoreButtons size="lg" />
        </div>
      </div>
      <figure class="hero-figure">
        <Image
          src={programImages.cgmKit}
          alt="크림색 종이 위에 놓인 작고 둥근 연속혈당측정 센서와 흰색 부착기, 접힌 설명서."
          widths={[640, 960, 1400]}
          sizes="(max-width: 900px) 100vw, 55vw"
          loading="eager"
        />
      </figure>
    </div>
  </section>

  <!-- 2. 왜 혈당인가 -->
  <section class="section why">
    <div class="container">
      <SectionHead eyebrow="01 — Why Glucose" variant="split">
        다이어트, 왜 혈당부터일까요?
        <Fragment slot="sub">
          먹고, 움직이고, 쉬는 일은 모두 혈당 흐름에 고스란히 남아요.<br />
          그 흐름을 보면 <strong>막연한 절제 대신 내 몸에 맞는 선택</strong>이 보여요.
        </Fragment>
      </SectionHead>

      <div class="why-grid">
        <figure class="why-figure reveal">
          <Image
            src={programImages.noodles}
            alt="위에서 내려다본 애호박 칼국수 한 그릇과 김치 한 접시, 수저."
            widths={[600, 1000]}
            sizes="(max-width: 900px) 100vw, 45vw"
            loading="lazy"
          />
        </figure>
        <ol class="why-list">
          {
            principles.map((p, i) => (
              <li class="why-item reveal">
                <span class="cell-index">{String(i + 1).padStart(2, '0')}</span>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <p class="sources">
        참고한 연구 ·{' '}
        {
          sources.map((s, i) => (
            <>
              {i > 0 && ' · '}
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
            </>
          ))
        }
      </p>
    </div>
  </section>

  <!-- 3. 프로그램 흐름 -->
  <section class="section steps">
    <div class="container">
      <SectionHead eyebrow="02 — The Program">
        글루밍 프로그램은 이렇게 흘러가요
        <Fragment slot="sub">재고, 찍고, 미리 보고, 움직이고, 돌아보고. 그리고 함께.</Fragment>
      </SectionHead>

      <div class="step-list">
        {
          steps.map((s, i) => (
            <details class="step" name="program-step" open={i === 0}>
              <summary>
                <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="step-en">{s.en}</span>
                <span class="step-title">{s.title}</span>
                <svg class="chev" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M4 7l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </summary>
              <div class="step-body">
                <p>{s.desc}</p>
                <PhoneFrame width={220}>
                  <Image src={s.img} alt={s.alt} widths={[240, 480]} sizes="220px" loading="lazy" />
                </PhoneFrame>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. 오래 가는 변화 -->
  <section class="section changes">
    <div class="container">
      <SectionHead eyebrow="03 — Lasting Change" variant="split">
        오래 가는 변화는, 생활에서 시작돼요
        <Fragment slot="sub">
          짧게 참고 다시 돌아오는 대신,<br />매일 하는 작은 일을 조금씩 바꿔요.
        </Fragment>
      </SectionHead>

      <div class="change-grid">
        {
          changes.map((c, i) => (
            <article class:list={['change', 'reveal', { 'is-lead': i === 0 }]}>
              <div class="change-img">
                <Image
                  src={c.img}
                  alt={c.alt}
                  widths={i === 0 ? [640, 1200] : [400, 800]}
                  sizes={i === 0 ? '(max-width: 900px) 100vw, 58vw' : '(max-width: 900px) 100vw, 38vw'}
                  loading="lazy"
                />
              </div>
              <p class="change-kicker">{c.kicker}</p>
              <h3>{c.title}</h3>
              <p class="change-desc">{c.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 5. 글루밍즈 -->
  <section class="section friends">
    <div class="container">
      <SectionHead eyebrow="04 — With the Glumings">
        숫자 대신 표정으로, 곁에서 함께해요
        <Fragment slot="sub">
          혈당 흐름에 따라 글루밍즈의 표정이 달라져요. 혼자 버티는 다이어트가 아니라, 같이 걷는 하루예요.
        </Fragment>
      </SectionHead>
      <div class="cells friend-cells">
        {characters.map((c) => <CharacterCard character={c} state="happy" />)}
      </div>
    </div>
  </section>

  <!-- 6. 신뢰 -->
  <section class="section trust">
    <div class="container">
      <Credentials />
      <p class="trust-more">
        앱에서 쓰는 혈당 기준과 출처는 <a href="/medical">의료 정보 기준·출처</a>에 공개해 두었어요.
      </p>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section faq-sec">
    <div class="container">
      <SectionHead eyebrow="FAQ">자주 묻는 질문</SectionHead>
      <Faq items={faqs} />
    </div>
  </section>

  <!-- 8. CTA -->
  <section class="section cta">
    <div class="container">
      <div class="cta-band">
        <Sprout size={58} tile={false} class="cta-mascot" />
        <p class="eyebrow on-dark">Start Today</p>
        <h2 class="cta-title">오늘 한 끼부터,<br />내 몸의 흐름을 살펴볼까요?</h2>
        <p class="cta-sub">거창한 결심은 필요 없어요. 첫 끼를 찰칵, 그리고 문 앞 10분이면 충분해요.</p>
        <div class="cta-actions">
          <StoreButtons size="lg" tone="dark" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero {
    padding-top: clamp(48px, 7vw, 96px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-title {
    font-size: var(--fs-h1);
    line-height: var(--lh-title);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .hero-lead {
    margin-top: var(--sp-5);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.78;
    max-width: 560px;
  }
  .hero-lead strong {
    color: var(--text);
    font-weight: 700;
  }
  .hero-actions {
    margin-top: var(--sp-7);
  }
  .hero-figure,
  .why-figure,
  .change-img {
    margin: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--card-soft);
  }
  .hero-figure :global(img),
  .why-figure :global(img),
  .change-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-figure {
    aspect-ratio: 3 / 2;
  }

  /* ── WHY ── 사진 한 장 + 번호 목록 */
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .why-figure {
    aspect-ratio: 3 / 2;
    position: sticky;
    top: calc(var(--nav-h-min) + 24px);
  }
  .why-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .why-item {
    padding: var(--sp-6) 0;
    border-top: 1px solid var(--rule);
  }
  .why-item:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .why-item h3 {
    margin-top: var(--sp-2);
