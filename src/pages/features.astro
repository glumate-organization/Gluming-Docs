---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SectionHead from '../components/SectionHead.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { conditionScreens, screens } from '../lib/assets';

const title = '기능 — 실제 앱 화면으로 보는 글루밍';
const description =
  '컨디션을 표정으로 보여주고, 지금 움직이면 혈당이 어떻게 변할지 운동별로 견줘 보고, 사진 한 장으로 식사를 기록해요. 미션·포인트와 주간 건강 리포트까지, 실제 앱 화면으로 만나보세요.';

// 딥다이브 기능 행 — 실제 구동 화면과 함께 좌우 교차 배치.
const deepDives = [
  {
    eyebrow: 'Condition at a glance',
    title: '숫자 대신, 표정으로 알아요',
    img: screens.homeGood,
    alt: '글루밍 홈 화면. 캐릭터가 웃는 표정으로 "리듬이 아주 좋아요, 이대로 가요!"라고 알려주고 혈당 109 mg/dL과 오늘의 점수 68·평균 혈당 91·변동성 낮음이 함께 보인다.',
    lead:
      '109, 187 같은 숫자만 보면 지금이 괜찮은 건지 애매하잖아요.<br />' +
      '글루밍즈가 <strong>표정과 한마디</strong>로 지금 흐름을 먼저 알려드려요.<br />' +
      '아래에는 오늘의 점수·평균 혈당·변동성이 한 줄로 정리돼요.',
    points: [
      '컨디션에 따라 표정과 배경색이 달라져요',
      '오늘의 점수 · 평균 혈당 · 변동성을 한눈에 봐요',
      '바로 아래에서 "지금 움직이면?"으로 이어져요',
    ],
  },
  {
    eyebrow: 'Simulate before you move',
    title: '지금 움직이면 어떻게 될까요?',
    img: screens.simExercise,
    alt: '“어떤 운동을 해볼까요?” 화면. 빠른 걷기 -2, 스쿼트 -14, 런닝 -9처럼 운동별 30분 뒤 예상 변화가, 아무것도 안 했을 때를 나타내는 점선과 겹친 미니 그래프로 비교된다.',
    lead:
      '가만히 있을 때와 몸을 움직였을 때를 <strong>나란히 놓고</strong> 비교해요.<br />' +
      '빠른 걷기·스쿼트·런닝까지, 각각 30분 뒤 흐름이 어떻게 달라지는지 미리 그려봐요.<br />' +
      '지난 7일간 쌓인 내 데이터를 바탕으로 계산한 참고값이에요.',
    points: [
      '"아무것도 안 했을 때"를 기준선으로 함께 보여줘요',
      '운동 종류·시간별로 예상 변화를 견줘 봐요',
      '마음에 드는 운동은 그 자리에서 바로 기록으로 이어져요',
    ],
  },
  {
    eyebrow: 'One photo is enough',
    title: '찰칵 한 번이면 기록 끝',
    img: screens.mealDetect,
    alt: '음식 인식 화면. 한 상 사진에서 돼지고기 김치찜·두부구이·파무침·굴전·깻잎장아찌·땅콩조림·흰쌀밥·소고기 육개장 8개를 각각 네모로 잡아내고, 총 탄수화물 136g·1,250kcal과 음식별 영양이 정리돼 있다.',
    lead:
      '기록이 숙제처럼 느껴지면 오래가기 어렵잖아요.<br />' +
      '한 상을 찰칵 찍으면 <strong>음식과 탄수화물을 알아서</strong> 찾아내요.<br />' +
      '그리고 이 식사 뒤 흐름이 어떻게 이어질지도 함께 그려드려요.',
    points: [
      '한 상에 올라온 여러 음식을 한 번에 인식해요',
      '음식별 양·탄수화물·칼로리를 정리해 보여줘요',
      '먹기 전에 예상 흐름과 추천 섭취 순서를 함께 봐요',
    ],
  },
  {
    eyebrow: 'Log in three taps',
    title: '운동 기록은 톡톡톡, 세 번이면 끝',
    img: screens.logExercise,
    alt: '운동 기록 화면. 스트레칭·산책·빠른걷기·계단오르기 중 선택하고 시간 30분, 강도 중강도를 고르는 모습.',
    lead:
      '종류 고르고, 시간 정하고, 강도 누르면 끝이에요.<br />' +
      '기록하는 순간 <strong>이 운동이면 어느 정도일지</strong> 바로 알려드려요.<br />' +
      '걸음 수처럼 자동으로 들어오는 값은 따로 적지 않아도 돼요.',
    points: [
      '자주 하는 운동은 칩으로 바로 고를 수 있어요',
      '5분 단위로 시간을 맞추고 강도는 세 단계 중에 골라요',
      '고르는 동안 예상 변화가 아래에서 함께 바뀌어요',
    ],
  },
  {
    eyebrow: 'Missions & points',
    title: '작은 미션으로 하루가 차곡차곡',
    img: screens.mission,
    alt: '미션 화면. 연속 달성 스탬프와 함께 식사 기록하기(+50P), 사진으로 식사 기록(+50P), 운동 기록하기(+50P), 8,000보 걷기(+100P) 미션이 진행바와 함께 나열되고, 아래에 이번 주 도전이 이어진다.',
    lead:
      '오늘 할 일은 딱 네 가지, 그것도 <strong>이미 하고 있는 것들</strong>이에요.<br />' +
      '식사와 운동을 기록하고, 오늘 걸음을 채우면 그대로 포인트가 돼요.<br />' +
      '하루하루 이어가면 보너스가 붙고, 모은 포인트로 새 친구를 만나요.',
    points: [
      '기록하는 것만으로 미션이 채워져서 부담이 적어요',
      '연속으로 이어가면 보너스 포인트를 받아요',
      '이번 주 도전까지 채우면 추가 보상이 기다려요',
    ],
  },
  {
    eyebrow: 'Your day, all in one place',
    title: '하루를 한 화면에 소복이 모아서',
    img: screens.dailyLog,
    alt: '하루 기록 화면. 하루 혈당 곡선(평균 101, 최저 88, 최고 136)과 걸음 수 2,289걸음, 물 섭취, 그날의 기록 내역이 한 화면에 모여 있다.',
    lead:
      '오늘 하루가 어떻게 흘렀는지 <strong>한 화면에</strong> 모아서 보여드려요.<br />' +
      '혈당 곡선 위에 목표 범위를 겹쳐 그려서, 어느 시간대가 어땠는지 눈으로 바로 읽혀요.<br />' +
      '걸음 수와 물처럼 같이 챙기면 좋은 것들도 옆에 나란히 놓여 있어요.',
    points: [
      '날짜를 옆으로 넘기며 지난 날들을 편하게 되짚어요',
      '평균 · 최저 · 최고를 한 줄로 정리해 보여줘요',
      '그날의 식사·운동 기록이 시간 순으로 함께 쌓여요',
    ],
  },
  {
    eyebrow: 'A week in one view',
    title: '일주일을 모아 보면 내 리듬이 보여요',
    img: screens.reportGlucose,
    alt: '건강 리포트 혈당 탭. 평균 혈당 97 mg/dL, 변동성(CV) 14.5%, 목표 범위 시간(TIR) 97%, 최고 혈당 154 mg/dL과 최근 7일 시간대별 평균 곡선, 일별 평균 혈당 변화가 보인다.',
    lead:
      '하루하루는 들쭉날쭉해도, <strong>일주일을 모아 보면</strong> 내 리듬이 보여요.<br />' +
      '평균과 변동성, 목표 범위 안에 머문 시간을 정리해 드려요.<br />' +
      '식사 탭에서는 자주 먹은 음식과 혈당을 많이 올린 끼니도 확인할 수 있어요.',
    points: [
      '평균 · 변동성(CV) · 목표 범위 시간(TIR)을 함께 봐요',
      '하루를 겹쳐 그린 시간대별 평균 곡선으로 습관이 드러나요',
      '자주 먹은 음식과 상승폭이 컸던 끼니를 Top 3로 짚어줘요',
    ],
  },
];


---

<Layout title={title} description={description}>
  <!-- 1. HERO -->
  <section class="section hero">
    <div class="container hero-inner">
      <span class="eyebrow">00 — Features</span>
      <h1 class="hero-title">글루밍, 이렇게 생겼어요</h1>
      <p class="hero-lead">
        아래 화면은 모두 <strong>실제 글루밍 앱</strong>을 그대로 담은 거예요.<br />
        컨디션을 표정으로 보여주고, 무언가를 하기 전에 흐름을 미리 그려보고,
        기록은 최대한 가볍게. 하나씩 살펴볼까요?
      </p>
      <div class="hero-actions">
        <StoreButtons size="lg" />
      </div>
    </div>
  </section>

  <!-- 2. 컨디션 표정 스트립 -->
  <section class="section faces">
    <div class="container">
      <SectionHead eyebrow="Five faces" variant="split">
        오늘의 나를, 다섯 가지 표정으로
        <Fragment slot="sub">
          같은 숫자여도 흐름에 따라 몸의 느낌은 다르잖아요.<br />
          글루밍즈가 <strong>표정과 배경색</strong>으로 지금을 먼저 귀띔해 드려요.
        </Fragment>
      </SectionHead>

      <ul class="face-strip">
        {
          conditionScreens.map((c) => (
            <li class="face-item reveal">
              <div class="face-shot">
                <Image
                  src={c.img}
                  alt={`글루밍 홈 화면 — ${c.caption}`}
                  widths={[280, 560]}
                  sizes="(max-width: 640px) 60vw, 220px"
                  loading="lazy"
                />
              </div>
              <p class="face-caption">{c.caption}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. DEEP-DIVE 기능 행 -->
  <section class="section deepdives">
    <div class="container">
      {
        deepDives.map((f, i) => {
          const num = String(i + 1).padStart(2, '0');
          return (
            <article class={`row reveal ${i % 2 === 1 ? 'row-reverse' : ''}`}>
              <div class="row-media">
                <PhoneFrame width={282}>
                  <Image
                    src={f.img}
                    alt={f.alt}
                    widths={[300, 600]}
                    sizes="282px"
                    loading="lazy"
                  />
                </PhoneFrame>
              </div>
              <div class="row-text">
                <span class="row-num" aria-hidden="true">
                  {num}
                </span>
                <span class="eyebrow">{f.eyebrow}</span>
                <h2 class="row-title">{f.title}</h2>
                <p class="row-lead" set:html={f.lead} />
                <ul class="row-points">
                  {f.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <!-- 4. CTA 밴드 (+ 의료 비대체 고지) -->
  <section class="section cta">
    <div class="container">
      <p class="page-note">
        글루밍은 생활습관 관리를 돕는 <strong>보조 도구</strong>예요. 전문적인
        진료나 상담을 대신하지 않고, 곁에서 살포시 거들게요.
      </p>
      <div class="cta-band">
        <p class="eyebrow on-dark">Start Today</p>
        <h2 class="cta-title">행동 전에 한 번 더 살펴보는 습관,<br />함께 시작해요</h2>
        <p class="cta-sub">
          글루밍즈 친구들과 함께, 오늘부터 내 혈당 흐름을 미리 그려볼까요?
        </p>
        <div class="cta-actions">
          <StoreButtons size="lg" tone="dark" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero {
    padding-top: clamp(56px, 8vw, 104px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .hero-inner {
    max-width: 820px;
  }
  .hero-title {
    font-size: var(--fs-h1);
    line-height: var(--lh-title);
    text-wrap: balance;
  }
  .hero-lead {
    margin-top: var(--sp-5);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.78;
    max-width: 680px;
  }
  /* 강조는 색이 아닌 굵기로만 (색 강조 금지) */
  .hero-lead strong,
  .hero-actions {
    margin-top: var(--sp-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }

  /* ── 컨디션 표정 스트립 ── */
  .faces {
    padding-top: 0;
  }
  .face-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(12px, 2vw, 24px);
  }
  .face-item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  /* 캐릭터 카드가 있는 위쪽만 잘라 보여준다 */
  .face-shot {
    position: relative;
    border-radius: var(--r-lg);
    border: 1px solid var(--rule);
    overflow: hidden;
    aspect-ratio: 1206 / 1180;
    background: var(--card-soft);
  }
  .face-shot :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .face-caption {
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.55;
    text-align: center;
  }

  /* ── DEEP-DIVE 행 ── 헤어라인으로 구분되는 비대칭 교차 배치 */
  .deepdives {
    padding-top: clamp(24px, 4vw, 48px);
  }
  .row {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    padding: clamp(48px, 7vw, 88px) 0;
    border-top: 1px solid var(--rule);
  }
  .row:first-child {
    border-top: 0;
    padding-top: clamp(24px, 4vw, 40px);
  }
  .row-reverse {
    grid-template-columns: 1.15fr 0.85fr;
  }
  .row-reverse .row-media {
    order: 2;
  }
  .row-media {
    display: flex;
    justify-content: center;
  }
  /* 큰 세리프 인덱스 — 지면의 챕터 번호처럼 */
  .row-num {
    display: block;
    margin-bottom: var(--sp-3);
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--sand);
  }
  .row-title {
    margin-top: var(--sp-1);
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
    line-height: var(--lh-title);
  }
  .row-lead {
    margin-top: var(--sp-4);
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.8;
    max-width: 560px;
  }
  .row-points {
    margin: var(--sp-6) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .row-points li {
    position: relative;
    padding: 13px 0 13px 26px;
    color: var(--text);
    font-size: var(--fs-body);
    line-height: 1.6;
    border-top: 1px solid var(--rule);
  }
  .row-points li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .row-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 21px;
    width: 10px;
    height: 10px;
    border-radius: var(--r-pill);
    border: 1.5px solid var(--sage);
  }


  /* 의료 비대체 고지 — 연동·로그인 섹션이 빠지면서 독립 블록으로 옮겼다. 문구는 유지. */
  .page-note {
    margin: 0 auto var(--sp-8);
    max-width: var(--measure);
    text-align: center;
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    color: var(--text-3);
  }
  .page-note strong {
    color: var(--text-2);
    font-weight: 600;
  }

  /* ── CTA 밴드 ── pine 다크 밴드, 납작하게 */
  .cta-band {
    position: relative;
    background: var(--pine);
    color: var(--on-dark);
    border-radius: var(--r-lg);
    padding: clamp(48px, 7vw, 88px) clamp(24px, 5vw, 64px);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  /* 다크 면에도 같은 종이 질감 (배경 위 · 내용 아래) */
  .cta-band::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--grain);
    background-size: 180px 180px;
    opacity: 0.07;
    pointer-events: none;
  }
  .eyebrow.on-dark {
    color: var(--primary-light);
  }
  .cta-title {
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
    line-height: var(--lh-title);
    max-width: 720px;
    margin-inline: auto;
    color: var(--on-dark);
  }
  .cta-sub {
    margin: var(--sp-5) auto var(--sp-7);
    max-width: 520px;
    color: color-mix(in srgb, var(--on-dark) 78%, transparent);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .cta-actions {
    display: flex;
    justify-content: center;
  }

  /* ── 반응형 ── */
  @media (max-width: 1023px) {
    .row,
    .row-reverse {
      grid-template-columns: 1fr;
