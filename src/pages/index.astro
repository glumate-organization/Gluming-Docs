---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import CharacterCard from '../components/CharacterCard.astro';
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { mobileAppSchema } from '../lib/seo';
import { characters, charactersByKey, programImages } from '../lib/assets';

// 홈은 앱 화면 대신 "건강하게 · 함께 · 즐겁게"의 분위기를 먼저 보여준다.
// 사람 사진 대신 단색 배경 위 오브젝트 컷 — 장면을 물건 하나로 말한다 (AI 인물 사진의 어색함을 피한다).
// 같은 폭 카드 3장 대신 7:5 / 5:7 지그재그로 엇갈려 잡지 지면처럼 배치한다.
const moments = [
  {
    img: programImages.sensorPhone,
    alt: '구김 있는 리넨 위에 놓인 작고 둥근 흰색 연속혈당측정 센서와 엎어 둔 휴대폰.',
    kicker: '지금 내 몸은 어떤 리듬일까요',
    title: '내 혈당의 변화를 쉽게 확인할 수 있어요',
    desc: '점심 한 그릇 앞에서 폰을 한 번 열어 보면 끝. 숫자를 해석하느라 애쓰지 않아도, 글루밍즈의 표정과 흐름 그래프가 오늘의 컨디션을 먼저 알려줘요.',
    wide: true,
  },
  {
    img: programImages.doorHooks,
    alt: '저녁 햇살이 비스듬히 드는 현관 벽, 나무 고리에 걸린 크기가 다른 모자 두 개와 에코백.',
    kicker: '지금, 더 건강한 내일을 위해',
    title: '함께 걷는 저녁 30분',
    desc: '검진 결과지를 받아 든 날, 막막함보다 먼저 신발 끈을 매요. 거창한 계획 대신 저녁마다 같이 걷기로 해요. 오늘 걸은 만큼 내 몸이 어떻게 답하는지, 글루밍이 살며시 보여드려요.',
    wide: false,
  },
  {
    img: programImages.breakfast,
    alt: '나무 식탁 위의 아침. 달걀 하나, 통밀빵 한 조각, 블루베리 얹은 요거트와 물 한 잔.',
    kicker: '같이 먹으니까 더 맛있고, 더 건강해요',
    title: '몸이 좋아하는 식단은 참는 식단이 아니에요',
    desc: '무엇을 먼저 먹을지 같이 고르는 작은 놀이. 먹기 전에 내 혈당 흐름을 한 번 그려보면, 식탁이 훨씬 즐거워져요.',
    wide: false,
  },
  {
    img: programImages.familyMugs,
    alt: '나무 식탁 위에 나란히 놓인 크기가 다른 머그 세 개. 큰 오트밀색, 중간 세이지색, 아이용 작은 흰색.',
    kicker: '엄마의 산책에 같이 나섰어요',
    title: '내 몸을 알아가는 일, 가족과 나눠요',
    desc: '엄마 팔에 붙은 작은 센서를 딸이 먼저 궁금해했어요. 오늘 걸은 뒤 흐름이 어땠는지 같이 들여다보면, 잔소리 대신 대화가 생겨요.',
    wide: true,
  },
];

// 작은 습관 — 물건 하나 + 한 줄. 화면에 들어오면 한 장씩 차례로 올라온다.
const habits = [
  { img: programImages.bed, alt: '아침 햇살이 드는 침대 위의 흰 베개와 개어 둔 리넨 이불.', title: '푹 자기', desc: '잠을 설친 다음 날은 혈당 흐름도 무거워지기 쉬워요.' },
  { img: programImages.waterApple, alt: '물 한 잔과 잎이 달린 풋사과 하나.', title: '단 음료 대신 물 한 잔', desc: '가장 쉽게 바꿀 수 있는 한 가지예요.' },
  { img: programImages.notebook, alt: '펼쳐진 작은 크라프트지 노트와 그 위에 놓인 연필.', title: '한 끼를 남겨 두기', desc: '기록이 쌓이면 나에게 맞는 선택이 보여요.' },
  { img: programImages.clock, alt: '나무 선반 위 벽에 기대 놓인 크림색 아날로그 시계.', title: '30분마다 일어나기', desc: '오래 앉아 있는 시간을 짧은 걸음으로 끊어요.' },
];
---

<Layout
  title="글루밍 - 함께 관리하는 재미있는 혈당 관리 문화"
  description="혼자 하던 혈당관리, 이제 함께해요. 글루밍은 CGM 혈당과 식사·걸음 기록으로 나에게 맞는 관리법을 찾고, 가족·메이트의 응원으로 함께 관리하는 재미있는 혈당 관리 문화를 만들어가요."
  jsonLd={[mobileAppSchema()]}
>
  <!-- ── 1. HERO — 문구 + 오브젝트 컷 콜라주 (사람 사진·앱 화면 없이) ── -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">A Wellness Companion</p>
        <h1 class="hero-title">
          함께, 재미있게, 행복하게<br />
          글루밍과 함께해요
        </h1>
        <p class="hero-lead">
          나의 혈당을 건강하게 돌보는 가장 다정한 방법. <br />
          가족과 걷고, 같이 먹고, 웃는 평범한 하루에 글루밍이 살며시 스며들어요.
        </p>
        <div class="hero-cta">
          <StoreButtons size="lg" />
        </div>
        <p class="hero-note">
          <a href="/program">글루밍 프로그램 알아보기 →</a>
        </p>
      </div>
      <!-- 큰 컷 하나 + 작은 컷 둘이 겹쳐 놓이고, 스크롤하면 서로 다른 속도로 움직인다 -->
      <div class="hero-art">
        <figure class="art art-a">
          <Image
            src={programImages.cgmArm}
            alt="팔 뒤쪽에 붙은 작고 둥근 흰색 연속혈당측정 센서."
            widths={[600, 900, 1200]}
            sizes="(max-width: 980px) 80vw, 560px"
            loading="eager"
          />
        </figure>
        <figure class="art art-b">
          <Image
            src={programImages.mealTray}
            alt="나무 쟁반 위의 잡곡밥과 나물, 생선구이 한 끼."
            widths={[300, 600]}
            sizes="240px"
            loading="eager"
          />
        </figure>
        <figure class="art art-c">
          <Image
            src={programImages.sneakers}
            alt="회색 캔버스 운동화 한 켤레."
            widths={[300, 600]}
            sizes="220px"
            loading="eager"
          />
        </figure>
        <Image
          class="art-char"
          src={charactersByKey.ribuni.states.happy}
          alt=""
          width={120}
          height={120}
          densities={[1, 2]}
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- ── 2. 비의료 고지 ─────────────────────────────── -->
  <section class="trust">
    <div class="container trust-inner">
      <p class="trust-note">
        의료기기가 아니에요 · 생활습관 관리를 돕는 웰니스 서비스예요
      </p>
    </div>
  </section>

  <!-- ── 2.5 우리가 만들고 싶은 문화 — 장식 없이 글만 ────────── -->
  <section class="story" aria-labelledby="story-title">
    <div class="container">
      <div class="story-inner reveal">
        <h2 id="story-title" class="story-q">혼자 하던 혈당관리, 힘들지 않았나요?</h2>
        <p>
          글루밍은 함께 관리하는 재미있는 혈당 관리 문화를 만들어가고 있어요.<br />
          내가 먹은 음식과 혈당 변화를 보면서 나에게 맞는 관리 방법을 찾아가요.
        </p>
        <p>
          그리고 가족의 “어떻게 도와주면 좋을까?”라는 걱정을 메이트의 이해와 응원으로
          해결할 수 있어요. 함께 먹을 음식을 고르고, 산책하고, 작은 노력에도 따뜻한
          격려를 건네는 일상을 만들어 보는 거 어때요?
        </p>
        <p class="story-end">
          가족과 함께 만들어가는 재미있는 혈당 관리 문화, 글루밍과 같이 만들어봐요.
        </p>
      </div>
    </div>
  </section>

  <!-- ── 3. 일상의 장면들 ──────────────────────────────── -->
  <section class="section everyday">
    <div class="container">
      <SectionHead eyebrow="01 — Everyday" variant="split">
        거창한 결심 말고,<br />오늘 한 끼와 한 걸음부터
        <Fragment slot="sub">
          건강한 습관은 특별한 날이 아니라 평범한 저녁에 자라요.<br />
          같이 걷고, 같이 먹고, 내 몸이 어떻게 답하는지 함께 살펴보는 하루.
          글루밍이 그 옆에 있을게요.
        </Fragment>
      </SectionHead>

      <div class="moments">
        {
          moments.map((m) => (
            <article class:list={['moment', 'reveal', { 'is-wide': m.wide }]}>
              <div class="moment-shot">
                <Image
                  class="drift"
                  src={m.img}
                  alt={m.alt}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 640px) 90vw, (max-width: 980px) 45vw, 700px"
                  loading="lazy"
                />
              </div>
              <p class="moment-kicker">{m.kicker}</p>
              <h3 class="moment-title">{m.title}</h3>
              <p class="moment-desc">{m.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── 4. 문제 정의 ──────────────────────────────────── -->
  <section class="section problem">
    <div class="container">
      <SectionHead eyebrow="02 — Why Gluming" variant="split">
        숫자는 차곡차곡 쌓이는데,<br />뭘 바꿔야 할지는 막막하죠
        <Fragment slot="sub">
          하루 몇 번 잰 숫자로는 그 사이의 흐름을 알기 어려워요.<br />
          “아, 아까 그걸 먹지 말걸” 하고 아쉬워한 적, 한 번쯤 있지 않나요?
        </Fragment>
      </SectionHead>

      <!-- 같은 하루를 두 방식으로: 손끝 측정의 점 몇 개 vs 끊김 없는 곡선 + 지금 이후 미리보기.
           좌표는 0–24시를 x 36–388에 펼친 가상의 하루. mg/dL 수치는 일부러 넣지 않는다. -->
      <div class="compare">
        <article class="compare-col is-before reveal">
          <span class="compare-tag">Before</span>
          <h3>하루 몇 번, 점으로만 봐요</h3>
          <svg class="cg" viewBox="0 0 400 206" role="img"
            aria-label="하루 다섯 번 잰 혈당 점만 보이고, 그 사이 새벽의 내림과 식후의 오름은 보이지 않는 그래프">
            <rect x="36" y="76" width="352" height="60" class="cg-band" />
            <line x1="36" y1="76" x2="388" y2="76" class="cg-edge" />
            <line x1="36" y1="136" x2="388" y2="136" class="cg-edge" />
            <text x="42" y="130" class="cg-band-cap">목표 범위</text>
            <path d="M36.0 112 C42.1 113.3 60.5 113.7 72.7 120 C84.9 126.3 99.5 148.7 109.3 150 C119.1 151.3 124.0 134.7 131.3 128 C138.6 121.3 146.7 122.7 153.3 110 C159.9 97.3 164.5 54.0 170.9 52 C177.3 50.0 184.7 88.0 191.5 98 C198.3 108.0 205.4 117.7 212.0 112 C218.6 106.3 224.2 65.3 231.1 64 C237.9 62.7 245.3 95.7 253.1 104 C260.9 112.3 270.2 113.3 278.0 114 C285.8 114.7 292.4 117.7 300.0 108 C307.6 98.3 315.7 57.7 323.5 56 C331.3 54.3 336.1 89.0 346.9 98 C357.6 107.0 381.1 108.0 388.0 110" class="cg-ghost" />
            <g class="cg-miss">
              <g transform="translate(109.3 150)"><circle r="9" /><text y="4">?</text></g>
              <g transform="translate(170.9 48)"><circle r="9" /><text y="4">?</text></g>
              <g transform="translate(231.1 60)"><circle r="9" /><text y="4">?</text></g>
              <g transform="translate(323.5 52)"><circle r="9" /><text y="4">?</text></g>
            </g>
            <g class="cg-pts">
              <circle cx="146" cy="116" r="5" />
              <circle cx="204.7" cy="110" r="5" />
              <circle cx="263.3" cy="110" r="5" />
              <circle cx="300" cy="108" r="5" />
              <circle cx="366" cy="104" r="5" />
            </g>
            <text x="388" y="22" class="cg-note" text-anchor="end">이 사이엔 알 수 없어요</text>
            <g class="cg-axis">
              <line x1="36" y1="180" x2="388" y2="180" />
              <text x="36" y="198">0시</text>
              <text x="124" y="198">6시</text>
              <text x="212" y="198">12시</text>
              <text x="300" y="198">18시</text>
              <text x="388" y="198">24시</text>
            </g>
          </svg>
          <p>
            손끝으로 재는 혈당은 하루 몇 번의 순간만 남겨요.<br />
            그 사이에 오르고 내린 흐름은 <strong>보이지 않아서</strong>, 무엇이 영향을 줬는지
            짐작만 하게 돼요.
          </p>
        </article>

        <article class="compare-col is-after reveal">
          <span class="compare-tag accent">Gluming</span>
          <h3>흐름을 잇고, 다음을 미리 봐요</h3>
          <svg class="cg" viewBox="0 0 400 206" role="img"
            aria-label="하루 흐름이 이어진 곡선으로 새벽 내림과 식후 오름이 보이고, 지금 이후는 그대로일 때와 걷고 났을 때의 흐름을 미리 그려 보여주는 그래프">
            <rect x="300" y="12" width="88" height="168" class="cg-ahead" />
            <rect x="36" y="76" width="352" height="60" class="cg-band is-on" />
            <line x1="36" y1="76" x2="388" y2="76" class="cg-edge" />
            <line x1="36" y1="136" x2="388" y2="136" class="cg-edge" />
            <text x="42" y="130" class="cg-band-cap is-on">목표 범위</text>
            <line x1="300" y1="12" x2="300" y2="180" class="cg-now" />
            <text x="304" y="24" class="cg-now-cap">지금</text>
            <path d="M36.0 112 C42.1 113.3 60.5 113.7 72.7 120 C84.9 126.3 99.5 148.7 109.3 150 C119.1 151.3 124.0 134.7 131.3 128 C138.6 121.3 146.7 122.7 153.3 110 C159.9 97.3 164.5 54.0 170.9 52 C177.3 50.0 184.7 88.0 191.5 98 C198.3 108.0 205.4 117.7 212.0 112 C218.6 106.3 224.2 65.3 231.1 64 C237.9 62.7 245.3 95.7 253.1 104 C260.9 112.3 270.2 113.3 278.0 114 C285.8 114.7 296.3 109.0 300.0 108" pathLength="1" class="cg-line cg-draw" />
            <path d="M300.0 108 C303.9 99.3 315.7 57.7 323.5 56 C331.3 54.3 336.1 89.0 346.9 98 C357.6 107.0 381.1 108.0 388.0 110" class="cg-pred" />
            <path d="M300.0 108 C303.4 104.0 314.1 84.7 320.5 84 C326.9 83.3 326.9 99.3 338.1 104 C349.4 108.7 379.7 110.7 388.0 112" class="cg-walk" />
            <circle cx="300" cy="108" r="5" class="cg-head" />
            <g class="cg-chip">
              <circle cx="109.3" cy="150" r="4.5" />
              <text x="109.3" y="170" text-anchor="middle">새벽 내림</text>
              <circle cx="170.9" cy="52" r="4.5" />
              <text x="170.9" y="38" text-anchor="middle">식후 오름</text>
            </g>
            <text x="338" y="44" class="cg-pred-cap">그대로라면</text>
            <text x="384" y="130" class="cg-walk-cap" text-anchor="end">10분 걸으면</text>
            <g class="cg-axis">
              <line x1="36" y1="180" x2="388" y2="180" />
              <text x="36" y="198">0시</text>
              <text x="124" y="198">6시</text>
              <text x="212" y="198">12시</text>
              <text x="300" y="198">18시</text>
              <text x="388" y="198">24시</text>
            </g>
          </svg>
          <p>
            이어진 흐름에서 <strong>놓치던 오르내림</strong>이 보여요.<br />
            먹기 전·걷기 전에 다음 흐름을 미리 그려 보고, 무엇을 하면 좋을지 살며시
            귀띔해 드려요.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── 5. 작은 습관 — 물건 하나 + 한 줄 ─────────────────── -->
  <section class="section habits">
    <div class="container">
      <SectionHead eyebrow="03 — Small Habits" variant="split">
        작은 습관이<br />큰 변화를 만들어요
        <Fragment slot="sub">
          작은 센서 하나가 더 건강한 일상을 만들어요.<br />
          오늘은 몸이 좋아하는 식단으로, 내일은 함께 걷는 산책으로.
          글루밍은 그 순간들을 차곡차곡 기록하고, 다음 한 걸음을 미리 그려봐요.
        </Fragment>
      </SectionHead>

      <ul class="habit-tiles">
        {
          habits.map((h, i) => (
            <li class="habit" style={`--i:${i}`}>
              <div class="habit-shot">
                <Image src={h.img} alt={h.alt} widths={[320, 640]} sizes="(max-width: 640px) 45vw, 280px" loading="lazy" />
              </div>
              <h3>{h.title}</h3>
              <p>{h.desc}</p>
            </li>
          ))
        }
      </ul>

      <div class="cta-row">
        <Button href="/blog" variant="secondary" size="md">혈당 노트에서 더 읽어 보기</Button>
      </div>
    </div>
  </section>

  <!-- ── 6. 글루밍즈 티저 ──────────────────────────────── -->
  <section class="section friends">
    <div class="container">
      <SectionHead eyebrow="04 — Meet the Glumings" variant="split">
        매일을 함께 걷는 친구들
        <Fragment slot="sub">
          기록도 습관도 혼자 하면 금세 지치잖아요.<br />
          글루밍즈가 옆에서 폴짝폴짝, 오늘의 작은 변화를 같이 응원할게요.
        </Fragment>
      </SectionHead>

      <div class="cells friend-cells">
        {characters.map((c) => <CharacterCard character={c} state="optimal" />)}
      </div>

      <div class="cta-row">
        <Button href="/characters" variant="secondary" size="md">
          글루밍즈 모두 만나기
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO — 왼쪽 문구, 오른쪽 오브젝트 컷 콜라주 ─────── */
  .hero {
    padding: clamp(48px, 7vw, 104px) 0 clamp(56px, 7vw, 96px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .hero-title {
    margin-top: var(--sp-1);
    /* 2열 히어로라 문구 칸이 좁다 — 두 줄을 지키도록 홈 전용 크기보다 한 단계 작게 */
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: var(--lh-tight);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .hero-lead {
    margin-top: var(--sp-6);
    max-width: 520px;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.8;
  }
  .hero-cta {
    margin-top: var(--sp-7);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .hero-note {
    margin-top: var(--sp-5);
  }
  .hero-note a {
    color: var(--sage-dark);
    font-weight: 600;
    font-size: var(--fs-body);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease);
  }
  .hero-note a:hover {
    border-bottom-color: currentColor;
  }

  /* 콜라주 — 큰 컷(a) 위에 작은 컷 둘(b, c)을 비껴 얹는다 */
  .hero-art {
    position: relative;
    aspect-ratio: 1 / 0.92;
  }
  .art {
    position: absolute;
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--card-soft);
    box-shadow: 0 24px 48px -28px rgba(46, 42, 36, 0.35);
  }
  .art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .art-a {
    inset: 6% 8% 14% 0;
  }
  .art-b {
    width: 44%;
    aspect-ratio: 4 / 3;
    right: 0;
    bottom: 0;
    rotate: 2deg;
    border: 6px solid var(--surface);
  }
  .art-c {
    width: 34%;
    aspect-ratio: 4 / 3;
    left: -4%;
    bottom: 2%;
    rotate: -3deg;
    border: 6px solid var(--surface);
  }
  .hero-art :global(.art-char) {
    position: absolute;
    top: -2%;
    right: 4%;
    width: clamp(72px, 9vw, 112px);
    height: auto;
  }

  /* 처음 열릴 때 — 문구가 먼저, 컷이 하나씩 내려앉는다 */
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* 캐릭터는 컷 위에서 살짝 숨 쉬듯 */
  @keyframes bob {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }
  /* 스크롤하면 컷마다 다른 속도로 — 깊이감 */
  @keyframes float-up {
    to {
      translate: 0 -48px;
    }
  }
  @keyframes float-up-more {
    to {
      translate: 0 -96px;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: settle 0.8s var(--ease) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .hero-copy > :nth-child(n + 4) {
      animation-delay: 0.24s;
    }
    .art-a {
      animation: settle 0.9s 0.15s var(--ease) both;
    }
    .art-b {
      animation: settle 0.9s 0.35s var(--ease) both;
    }
    .art-c {
      animation: settle 0.9s 0.5s var(--ease) both;
    }
    .hero-art :global(.art-char) {
      animation:
        settle 0.7s 0.75s var(--ease) both,
        bob 3.6s 1.5s ease-in-out infinite;
    }
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .art-b {
        animation:
          settle 0.9s 0.35s var(--ease) both,
          float-up linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 700px;
      }
      .art-c {
        animation:
          settle 0.9s 0.5s var(--ease) both,
          float-up-more linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 700px;
      }
    }
  }

  /* ── 비의료 고지 스트립 ─────────────────────────────── */
  .trust {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--warm) 45%, transparent);
  }
  .trust-inner {
    padding: var(--sp-4) 0;
  }
  .trust-note {
    margin: 0;
    color: var(--text-3);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  /* ── 우리가 만들고 싶은 문화 — 좁은 본문 폭의 짧은 글 ───── */
  .story {
    padding: var(--sp-10) 0 0;
  }
  .story-inner {
    max-width: 36em;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
  }
  .story-q {
    margin: 0 0 var(--sp-5);
    color: var(--text);
    font-size: var(--fs-h3);
    line-height: var(--lh-title);
    letter-spacing: -0.03em;
  }
  .story-inner p {
    margin: 0 0 var(--sp-4);
  }
  .story-inner .story-end {
    margin: var(--sp-5) 0 0;
    color: var(--primary-dark);
    font-weight: 600;
  }

  /* ── 일상의 장면들 ─────────────────────────────────── */
  /* 12칸 격자 — 넓은 장면(7) · 좁은 장면(5) 을 줄마다 엇갈려 놓는다 */
  .moments {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 40px);
  }
  .moment {
    grid-column: span 5;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
  }
  .moment.is-wide {
    grid-column: span 7;
  }
  .moment-shot {
    width: 100%;
    border-radius: var(--r-lg);
    border: 1px solid var(--rule);
    overflow: hidden;
    background: var(--card-soft);
  }
  .moment-shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .moment.is-wide .moment-shot :global(img) {
    aspect-ratio: 16 / 9;
  }
  .moment-kicker {
    margin-top: var(--sp-2);
    color: var(--sage-dark);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .moment-title {
    font-size: var(--fs-h3);
    line-height: var(--lh-title);
    letter-spacing: -0.02em;
  }
  .moment-desc {
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: 40ch;
  }

  /* ── 문제 정의 ─────────────────────────────────────── */
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--rule);
  }
  .compare-col {
    padding: var(--sp-7) clamp(24px, 4vw, 48px) var(--sp-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .compare-col.is-after {
    padding-left: clamp(24px, 4vw, 48px);
    padding-right: 0;
    border-left: 1px solid var(--rule);
  }
  .compare-col h3 {
    font-size: var(--fs-h3);
  }
  .compare-col.is-before h3 {
    color: var(--text-3);
  }
  .compare-col.is-after h3 {
    color: var(--pine);
  }
  .compare-col p {
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: 44ch;
  }
  .compare-tag {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .compare-tag.accent {
    color: var(--sage-dark);
  }

  /* 하루 흐름 그래프 — 점 몇 개 vs 이어진 곡선 + 미리보기 */
  .cg {
    width: 100%;
    max-width: 480px;
    height: auto;
    display: block;
    overflow: visible;
    font-family: var(--font-sans);
  }
  .cg-band {
    fill: color-mix(in srgb, var(--text-3) 10%, transparent);
  }
  .cg-band.is-on {
    fill: var(--primary-bg);
  }
  .cg-edge {
    stroke: var(--border);
    stroke-dasharray: 2 4;
  }
  .cg-band-cap {
    fill: var(--text-3);
    font-size: 10px;
    font-weight: 600;
  }
  .cg-band-cap.is-on {
    fill: var(--sage);
  }
  .cg-axis line {
    stroke: var(--border-strong);
  }
  .cg-axis text {
    fill: var(--text-3);
    font-size: 10px;
    text-anchor: middle;
  }
  .cg-ghost {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 1.4;
    stroke-dasharray: 1 5;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .cg-pts circle {
    fill: var(--text-2);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .cg-miss circle {
    fill: var(--gold-bg);
    stroke: var(--gold);
    stroke-width: 1.2;
  }
  .cg-miss text {
    fill: var(--gold-text);
    font-size: 11px;
    font-weight: 800;
    text-anchor: middle;
  }
  .cg-note {
    fill: var(--gold-text);
    font-size: 11px;
    font-weight: 700;
  }
  .cg-ahead {
    fill: color-mix(in srgb, var(--sand) 14%, transparent);
  }
  .cg-now {
    stroke: var(--text-3);
    stroke-dasharray: 3 4;
  }
  .cg-now-cap {
    fill: var(--text-2);
    font-size: 11px;
    font-weight: 700;
  }
  .cg-line {
    fill: none;
    stroke: var(--sage-dark);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cg-head {
    fill: var(--sage-dark);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .cg-pred,
  .cg-walk {
    fill: none;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-dasharray: 4 5;
  }
  .cg-pred {
    stroke: var(--gold);
  }
  .cg-walk {
    stroke: var(--primary);
  }
  .cg-pred-cap,
  .cg-walk-cap {
    font-size: 10.5px;
    font-weight: 700;
  }
  .cg-pred-cap {
    fill: var(--gold-text);
  }
  .cg-walk-cap {
    fill: var(--primary-dark);
  }
  .cg-chip circle {
    fill: var(--surface);
    stroke: var(--gold);
    stroke-width: 2;
  }
  .cg-chip text {
    fill: var(--gold-text);
    font-size: 10.5px;
    font-weight: 700;
  }
  /* 화면에 들어오면 곡선이 왼쪽부터 그려지고, 미리보기 선은 그 뒤에 나타난다 */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cg-draw {
        stroke-dasharray: 1;
        animation: cg-draw linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      .cg-pred,
      .cg-walk,
      .cg-pred-cap,
      .cg-walk-cap,
      .cg-head,
      .cg-miss {
        animation: cg-fade linear both;
        animation-timeline: view();
        animation-range: cover 35% cover 50%;
      }
    }
  }
  @keyframes cg-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes cg-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ── 작은 습관 — 물건 타일 4장, 차례로 올라온다 ─────── */
  .habit-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2.4vw, 32px);
  }
  .habit:nth-child(even) {
    margin-top: var(--sp-8); /* 엇갈린 높이 — 같은 카드 네 장이 일렬로 서지 않게 */
  }
  .habit-shot {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--card-soft);
  }
  .habit-shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease);
  }
  .habit:hover .habit-shot :global(img) {
    scale: 1.05;
  }
  .habit h3 {
    margin-top: var(--sp-4);
    font-size: var(--fs-h4);
    letter-spacing: -0.02em;
  }
  .habit p {
    margin-top: var(--sp-2);
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.7;
  }

  /* 장면 사진은 칸 안에서 스크롤 따라 살짝 흐른다 (패럴랙스) */
  @keyframes drift {
    from {
      translate: 0 -4%;
    }
    to {
      translate: 0 4%;
    }
  }
  @keyframes tile-in {
    from {
      opacity: 0;
      translate: 0 32px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .moment-shot :global(.drift) {
        scale: 1.1;
        animation: drift linear both;
        animation-timeline: view();
        animation-range: cover;
      }
      .habit-tiles {
        view-timeline: --habits block;
      }
      .habit {
        animation: tile-in linear both;
        animation-timeline: --habits;
        animation-range: entry calc(10% + var(--i) * 12%) entry calc(50% + var(--i) * 12%);
      }
    }
  }

  /* ── 격자 칸 ───────────────────────────────────────── */
  .friend-cells {
    grid-template-columns: repeat(4, 1fr);
  }
  /* 섹션 끝 버튼 — 본문과 같은 왼쪽 선에 맞춘다 */
  .cta-row {
    margin-top: var(--sp-7);
    display: flex;
    justify-content: flex-start;
  }

  /* ── 반응형 ────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-art {
      width: min(100%, 560px);
    }
    .habit-tiles {
      grid-template-columns: repeat(2, 1fr);
    }
    .moments {
      grid-template-columns: repeat(2, 1fr);
    }
    .moment,
    .moment.is-wide {
      grid-column: span 1;
    }
    .moment.is-wide .moment-shot :global(img) {
      aspect-ratio: 3 / 2;
    }
    .friend-cells {
      grid-template-columns: repeat(2, 1fr);
    }
    .compare {
      grid-template-columns: 1fr;
    }
    .compare-col {
      padding: var(--sp-6) 0;
      border-bottom: 1px solid var(--rule);
    }
    .compare-col:last-child {
      border-bottom: 0;
    }
    .compare-col.is-after {
      padding-left: 0;
      border-left: 0;
    }
  }

  /* ── 모바일 — 축소판이 아니라 네이티브처럼 차분하게. 정렬은 계속 왼쪽 ── */
  @media (max-width: 640px) {
    .hero {
      padding: var(--sp-8) 0 var(--sp-8);
    }
    .hero-title {
      font-size: clamp(30px, 8.6vw, 42px);
      line-height: 1.12;
    }
    .hero-lead {
      margin-top: var(--sp-5);
      font-size: 16px;
    }
    .hero-lead br {
      display: none;
    }
    .hero-cta {
      margin-top: var(--sp-6);
    }
    .trust-inner {
      padding: var(--sp-5) 0;
    }
    .story {
      padding-top: var(--sp-8);
    }
    .story-inner br {
      display: none;
    }
    .moments,
    .friend-cells {
      grid-template-columns: 1fr;
    }
    .habit:nth-child(even) {
      margin-top: var(--sp-6);
    }
    .cta-row {
      margin-top: var(--sp-6);
    }
    .cta-row :global(.btn) {
      width: 100%;
    }
  }
</style>
