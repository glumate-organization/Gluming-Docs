---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import CharacterCard from '../components/CharacterCard.astro';
import Layout from '../layouts/Layout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import SectionHead from '../components/SectionHead.astro';
import Sprout from '../components/Sprout.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { mobileAppSchema } from '../lib/seo';
import { characters, lifestyle, screens } from '../lib/assets';

// 홈은 앱 화면보다 "건강하게 · 함께 · 즐겁게"의 분위기를 먼저 보여준다.
// 라이프스타일 장면 4컷 — 사진 + 손글씨 톤의 한 줄(kicker) + 제목 + 짧은 글.
// 같은 폭 카드 3장 대신 7:5 / 5:7 지그재그로 엇갈려 잡지 지면처럼 배치한다.
// 분위기가 겹치지 않게: 낮의 카페(확인) → 노을 산책(운동) → 부엌(식사) → 삼대 산책(가족).
const moments = [
  {
    img: lifestyle.cafeCheck,
    alt: '햇살 드는 야외 카페에서 샐러드 앞에 앉아 스마트폰을 보며 웃는 여성. 팔에 작은 혈당 센서가 붙어 있고, 옆 테이블에 새싹 마스코트 인형이 놓여 있다.',
    kicker: '지금 내 몸은 어떤 리듬일까요',
    title: '내 혈당의 변화를 쉽게 확인할 수 있어요',
    desc: '점심 한 그릇 앞에서 폰을 한 번 열어 보면 끝. 숫자를 해석하느라 애쓰지 않아도, 글루밍즈의 표정과 흐름 그래프가 오늘의 컨디션을 먼저 알려줘요.',
    wide: true,
  },
  {
    img: lifestyle.coupleWalk,
    alt: '노을이 비치는 강변 산책로를 팔짱 끼고 걷는 중년 부부. 여성의 팔에 작은 혈당 센서가 붙어 있고 두 사람 모두 웃고 있다.',
    kicker: '지금, 더 건강한 내일을 위해',
    title: '함께 걷는 저녁 30분',
    desc: '검진 결과지를 받아 든 날, 막막함보다 먼저 손을 잡아요. 거창한 계획 대신 저녁마다 같이 걷기로 해요. 오늘 걸은 만큼 내 몸이 어떻게 답하는지, 글루밍이 살며시 보여드려요.',
    wide: false,
  },
  {
    img: lifestyle.familyCooking,
    alt: '햇살이 드는 부엌에서 온 가족이 샐러드를 만드는 모습. 엄마의 팔에 작은 혈당 센서가 붙어 있고 아이들이 채소를 집으며 웃고 있다.',
    kicker: '같이 먹으니까 더 맛있고, 더 건강해요',
    title: '몸이 좋아하는 식단은 참는 식단이 아니에요',
    desc: '무엇을 먼저 먹을지 아이와 같이 고르는 작은 놀이. 먹기 전에 내 혈당 흐름을 한 번 그려보면, 식탁이 훨씬 즐거워져요.',
    wide: false,
  },
  {
    img: lifestyle.threeGenerations,
    alt: '노을 지는 강변 산책로를 팔짱 끼고 걷는 삼대. 아버지, 딸, 어머니가 서로를 보며 웃고 있고 어머니의 팔에 작은 혈당 센서가 붙어 있다.',
    kicker: '엄마의 산책에 같이 나섰어요',
    title: '내 몸을 알아가는 일, 가족과 나눠요',
    desc: '엄마 팔에 붙은 작은 센서를 딸이 먼저 궁금해했어요. 오늘 걸은 뒤 흐름이 어땠는지 같이 들여다보면, 잔소리 대신 대화가 생겨요.',
    wide: true,
  },
];

// 앱은 뒤쪽에서 "입력 → 결과" 흐름으로. 같은 카드 3장 대신 실제 화면 두 컷을 짝지어 보여준다.
const flows = [
  {
    eyebrow: 'Snap, then look back',
    title: '찍으면, 먹은 뒤까지 돌아봐요',
    desc: '한 상을 찰칵 찍으면 음식과 탄수화물을 알아서 찾아내요. 며칠 뒤 리포트에서는 어떤 끼니가 얼마나 올렸는지, 다음엔 어떤 순서로 먹으면 좋을지까지 돌아볼 수 있어요.',
    from: {
      img: screens.mealDetect,
      label: '찍으면',
      alt: '음식 인식 화면. 한 상 사진에서 음식 8개를 각각 잡아내고 총 탄수화물 136g·1,250kcal을 정리해 보여준다.',
    },
    to: {
      img: screens.reportMealDetail,
      label: '이렇게 돌아봐요',
      alt: '건강 리포트의 끼니 상세. 7월 3일 점심 그릴드 스테이크와 아스파라거스 구이 등을 먹은 뒤 혈당 상승 +44 mg/dL과 "채소 → 단백질 → 탄수화물 순서로 드시면 상승 폭을 부드럽게 만들 수 있어요"라는 안내가 보인다.',
    },
    reverse: false,
  },
  {
    eyebrow: 'See, then move',
    title: '보고 나서, 움직여요',
    desc: '홈에서는 글루밍즈의 표정 하나로 지금 컨디션을 먼저 알려드려요. 바로 아래 "지금 움직이면?"을 누르면 빠른 걷기·스쿼트·런닝 뒤 30분 흐름을 나란히 견줘 볼 수 있어요.',
    from: {
      img: screens.homeGood,
      label: '지금은',
      alt: '글루밍 홈 화면. 캐릭터가 웃으며 "리듬이 아주 좋아요, 이대로 가요!"라고 알려주고 혈당 109 mg/dL이 크게 보인다.',
    },
    to: {
      img: screens.simExercise,
      label: '움직이면',
      alt: '“어떤 운동을 해볼까요?” 화면. 빠른 걷기·스쿼트·런닝의 30분 뒤 예상 변화를 점선 기준선과 함께 비교해 보여준다.',
    },
    reverse: true,
  },
];
---

<Layout
  title="글루밍 - 함께, 재미있게, 행복하게 혈당관리"
  description="글루밍은 CGM(연속혈당측정) 센서 값을 식사·운동 같은 하루 행동과 잇는 혈당 관리 습관 앱이에요. 가족과 걷고 같이 먹는 평범한 하루 안에서, 나의 혈당을 건강하게, 함께, 즐겁게 돌봐요."
  jsonLd={[mobileAppSchema()]}
>
  <!-- ── 1. HERO — 풀블리드 사진 위에 문구 (좌측 정렬) ────────── -->
  <section class="hero">
    <Image
      class="hero-bg"
      src={lifestyle.familyWalk}
      alt="노을 지는 강변 산책로를 손잡고 걷는 네 식구. 엄마의 팔에 작은 혈당 센서가 붙어 있고, 두 아이가 부모의 손을 잡고 웃고 있다."
      widths={[800, 1280, 1920]}
      sizes="100vw"
      loading="eager"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-copy">
      <p class="eyebrow on-photo">A Wellness Companion</p>
      <h1 class="hero-title">
        함께, 재미있게, 행복하게<br />
        글루밍과 함께해요
      </h1>
      <p class="hero-lead">
        나의 혈당을 건강하게 돌보는 가장 다정한 방법. <br />
        가족과 걷고, 같이 먹고, 웃는 평범한 하루에 글루밍이 살며시 스며들어요.
      </p>
      <div class="hero-cta">
        <StoreButtons size="lg" tone="dark" />
      </div>
      <p class="hero-note">
        <a href="/features">앱은 어떻게 생겼는지 보기 →</a>
      </p>
    </div>
    <!-- 실제 홈 화면 — 사진 위 오른쪽 아래에 살짝 얹는다. 첫 화면에서 제품이 보이게. -->
    <div class="hero-phone">
      <PhoneFrame width={250}>
        <Image
          src={screens.homeToday}
          alt="글루밍 홈 화면. 노란 배경 위에서 캐릭터가 두 팔을 들고 “오늘 컨디션 완전 좋아요!”라고 알려주고, 혈당 109 mg/dL과 오늘의 점수 90·평균 혈당 103·변동성 낮음이 보인다."
          widths={[300, 600]}
          sizes="250px"
          loading="eager"
        />
      </PhoneFrame>
    </div>
  </section>

  <!-- ── 2. 비의료 고지 ─────────────────────────────── -->
  <section class="trust">
    <div class="container trust-inner">
      <p class="trust-note">
        의료기기가 아니에요 · 생활습관 관리를 돕는 웰니스 서비스예요
      </p>
    </div>
  </section>

  <!-- ── 3. 일상의 장면들 ──────────────────────────────── -->
  <section class="section everyday">
    <div class="container">
      <SectionHead eyebrow="01 — Everyday" variant="split">
        거창한 결심 말고,<br />오늘 한 끼와 한 걸음부터
        <Fragment slot="sub">
          건강한 습관은 특별한 날이 아니라 평범한 저녁에 자라요.<br />
          같이 걷고, 같이 먹고, 내 몸이 어떻게 답하는지 함께 살펴보는 하루.
          글루밍이 그 옆에 있을게요.
        </Fragment>
      </SectionHead>

      <div class="moments">
        {
          moments.map((m) => (
            <article class:list={['moment', 'reveal', { 'is-wide': m.wide }]}>
              <div class="moment-shot">
                <Image
                  src={m.img}
                  alt={m.alt}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 640px) 90vw, (max-width: 980px) 45vw, 700px"
                  loading="lazy"
                />
              </div>
              <p class="moment-kicker">{m.kicker}</p>
              <h3 class="moment-title">{m.title}</h3>
              <p class="moment-desc">{m.desc}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── 4. 문제 정의 ──────────────────────────────────── -->
  <section class="section problem">
    <div class="container">
      <SectionHead eyebrow="02 — Why Gluming" variant="split">
        숫자는 차곡차곡 쌓이는데,<br />뭘 바꿔야 할지는 막막하죠
        <Fragment slot="sub">
          이미 혈당이 오른 뒤에야 알림이 와서 그래프를 들여다봐요.<br />
          “아, 아까 그걸 먹지 말걸” 하고 아쉬워한 적, 한 번쯤 있지 않나요?
        </Fragment>
      </SectionHead>

      <div class="compare">
        <article class="compare-col is-before reveal">
          <span class="compare-tag">Before</span>
          <h3>오른 뒤에야 알게 돼요</h3>
          <svg class="mini" viewBox="0 0 260 96" role="img"
            aria-label="혈당이 목표 범위를 넘어 오른 뒤에야 확인하게 되는 흐름 그래프">
            <rect x="0" y="40" width="260" height="30" rx="6" class="mini-band" />
            <path d="M4 74 C 44 70 72 44 110 32 S 196 16 256 22" class="mini-line" />
            <circle cx="256" cy="22" r="3.6" class="mini-dot" />
            <text x="196" y="12" class="mini-cap">이미 지나감</text>
          </svg>
          <p>
            식사가 끝나고 혈당이 오른 다음에야 알림이 울려요.<br />
            그래프를 봐도 <strong>이미 지나간 일</strong>이라, 다음을 어떻게 바꿔야 할지
            혼자 고민하게 돼요.
          </p>
        </article>

        <article class="compare-col is-after reveal">
          <span class="compare-tag accent">Gluming</span>
          <h3>변화를 미리 살펴봐요</h3>
          <svg class="mini" viewBox="0 0 260 96" role="img"
            aria-label="지금 이후의 혈당 흐름을 점선으로 미리 그려 보여주는 그래프">
            <rect x="0" y="40" width="260" height="30" rx="6" class="mini-band is-on" />
            <line x1="112" y1="10" x2="112" y2="86" class="mini-now" />
            <path d="M4 70 C 40 66 76 58 112 56" class="mini-line is-on" />
            <path d="M112 56 C 148 52 176 46 206 50 S 242 58 256 52" class="mini-pred" />
            <circle cx="112" cy="56" r="3.6" class="mini-dot is-on" />
            <circle cx="256" cy="52" r="3.6" class="mini-dot-open" />
            <text x="118" y="16" class="mini-cap is-on">지금부터</text>
          </svg>
          <p>
            먹기 전에, 움직이기 전에 <strong>내 혈당이 어떻게 변할지</strong> 미리
            알려드려요.<br />
            무엇을 하면 좋을지까지 살며시 귀띔해 주니까, 오늘의 관리가 한결 쉬워져요.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── 5. 작은 습관 — 콜라주 ─────────────────────────── -->
  <section class="section habits">
    <div class="container">
      <SectionHead eyebrow="03 — Small Habits" variant="split">
        작은 습관이<br />큰 변화를 만들어요
        <Fragment slot="sub">
          작은 센서 하나가 더 건강한 일상을 만들어요.<br />
          오늘은 몸이 좋아하는 식단으로, 내일은 함께 걷는 산책으로.
          글루밍은 그 순간들을 차곡차곡 기록하고, 다음 한 걸음을 미리 그려봐요.
        </Fragment>
      </SectionHead>

      <figure class="collage reveal">
        <Image
          src={lifestyle.momentsCollage}
          alt="일상 장면 7컷 콜라주. 노을 속 가족 산책 '오늘도 우리 가족의 건강한 하루', 팔에 붙인 센서 '작은 센서가 더 건강한 일상을 만들어요', 샐러드 준비 '오늘은 몸이 좋아하는 식단으로', 강아지와 산책 '함께 걷는 건강한 습관', 가족 식사 '같이 먹으니까 더 맛있고, 더 건강해요', 아침 스트레칭 '작은 습관이 큰 변화를 만들어요', 강변 벤치의 부부 '지금, 더 건강한 내일을 위해'."
          widths={[800, 1200, 1680]}
          sizes="(max-width: 1248px) 100vw, 1200px"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  <!-- ── 6. 앱은 뒤에서 조용히 ─────────────────────────── -->
  <section class="section features">
    <div class="container">
      <SectionHead eyebrow="04 — In the App" variant="split">
        복잡한 건 글루밍이,<br />선택은 언제나 나답게
        <Fragment slot="sub">
          앱은 조용히 뒤에서 거들어요. 표정으로 오늘을 알려주고, 행동 전에 흐름을
          미리 그려보고, 기록은 찰칵 한 번이면 끝.<br />
          아래는 모두 <strong>실제 앱 화면</strong>이에요.
        </Fragment>
      </SectionHead>

      <div class="flows">
        {
          flows.map((f, i) => (
            <article class:list={['flow', 'reveal', { 'is-reverse': f.reverse }]}>
              <div class="flow-text">
                <span class="flow-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="eyebrow">{f.eyebrow}</span>
                <h3 class="flow-title">{f.title}</h3>
                <p class="flow-desc">{f.desc}</p>
              </div>
              <div class="flow-shots">
                <figure class="flow-shot">
                  <PhoneFrame width={236}>
                    <Image
                      src={f.from.img}
                      alt={f.from.alt}
                      widths={[260, 520]}
                      sizes="236px"
                      loading="lazy"
                    />
                  </PhoneFrame>
                  <figcaption>{f.from.label}</figcaption>
                </figure>
                <span class="flow-arrow" aria-hidden="true">→</span>
                <figure class="flow-shot is-to">
                  <PhoneFrame width={236}>
                    <Image
                      src={f.to.img}
                      alt={f.to.alt}
                      widths={[260, 520]}
                      sizes="236px"
                      loading="lazy"
                    />
                  </PhoneFrame>
                  <figcaption>{f.to.label}</figcaption>
                </figure>
              </div>
            </article>
          ))
        }
      </div>

      <div class="cta-row">
        <Button href="/features" variant="secondary" size="md">
          기능 자세히 보기
        </Button>
      </div>
    </div>
  </section>

  <!-- ── 7. 글루밍즈 티저 ──────────────────────────────── -->
  <section class="section friends">
    <div class="container">
      <SectionHead eyebrow="05 — Meet the Glumings" variant="split">
        매일을 함께 걷는 친구들
        <Fragment slot="sub">
          기록도 습관도 혼자 하면 금세 지치잖아요.<br />
          글루밍즈가 옆에서 폴짝폴짝, 오늘의 작은 변화를 같이 응원할게요.
        </Fragment>
      </SectionHead>

      <div class="cells friend-cells">
        {characters.map((c) => <CharacterCard character={c} state="optimal" />)}
      </div>

      <div class="cta-row">
        <Button href="/characters" variant="secondary" size="md">
          글루밍즈 모두 만나기
        </Button>
      </div>
    </div>
  </section>

  <!-- ── 8. 최종 CTA ───────────────────────────────────── -->
  <section class="section cta-band-wrap">
    <div class="container">
      <div class="cta-band">
        <Sprout size={58} tile={false} class="cta-mascot" />
        <p class="eyebrow on-dark">Start Today</p>
        <h2 class="cta-title">오늘 저녁,<br />같이 걸어볼까요?</h2>
        <p class="cta-sub">
          행동하기 전에 내 혈당 흐름을 한 번 그려보는 습관.<br />
          함께라서 더 즐거운 하루를 글루밍과 시작해요.
        </p>
        <div class="cta-actions">
          <StoreButtons size="lg" tone="dark" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO — 풀블리드 사진 + 어두운 그라데이션 + 흰 문구 ─── */
  .hero {
    position: relative;
