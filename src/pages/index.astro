---
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import CharacterCard from '../components/CharacterCard.astro';
import Layout from '../layouts/Layout.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import ScreenCard from '../components/ScreenCard.astro';
import SectionHead from '../components/SectionHead.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { characters, healthImages, screens } from '../lib/assets';

// 실제 앱 화면으로 보여주는 핵심 기능 6가지.
const features = [
  {
    img: screens.homeGood,
    title: '컨디션을 표정으로',
    alt: '글루밍 홈 화면. 캐릭터가 웃으며 "리듬이 아주 좋아요"라고 알려주고 혈당 94 mg/dL이 크게 보인다.',
    desc: '숫자만 보면 지금이 괜찮은 건지 애매하잖아요. 글루밍즈가 표정과 한마디로 먼저 알려드려요.',
  },
  {
    img: screens.simExercise,
    title: '지금 움직이면 어떻게 될까요?',
    alt: '운동 시뮬레이터 화면. 가만히 있을 때와 스트레칭·산책의 예상 변화를 비교해 보여준다.',
    desc: '가만히 있을 때와 움직였을 때를 나란히 비교해요. 지난 14일 내 데이터로 계산한 참고값이에요.',
  },
  {
    img: screens.mealDetect,
    title: '사진 한 장이면 기록 끝',
    alt: '음식 인식 화면. 사진 속 여러 음식을 각각 찾아내고 예상 흐름을 함께 보여준다.',
    desc: '사진을 찍으면 음식과 탄수화물을 알아서 찾아내요. 먹기 전 흐름까지 미리 그려드려요.',
  },
  {
    img: screens.logExercise,
    title: '운동도 세 번만 누르면',
    alt: '운동 기록 화면. 운동 종류·시간·강도를 고르는 모습.',
    desc: '종류 고르고, 시간 정하고, 강도 누르면 끝. 고르는 동안 예상 변화가 같이 바뀌어요.',
  },
  {
    img: screens.mission,
    title: '오늘 나에게 맞는 미션',
    alt: '미션 화면. 연속 달성 스탬프와 오늘의 맞춤 미션이 포인트와 함께 나열된다.',
    desc: '최근 내 패턴을 보고 오늘 도움이 될 미션을 골라드려요. 모은 포인트로 새 친구를 만나요.',
  },
  {
    img: screens.reportGlucose,
    title: '2주 흐름을 한눈에',
    alt: '건강 리포트 화면. 평균 혈당·변동성·목표 범위 시간과 14일 평균 곡선이 보인다.',
    desc: '하루는 들쭉날쭉해도 2주를 모아 보면 리듬이 보여요. 평균·변동성·목표 범위 시간을 정리해요.',
  },
];

const syncPlatforms = [
  { img: healthImages.appleHealth, name: 'Apple 건강', alt: 'Apple 건강 앱 로고' },
  { img: healthImages.healthConnect, name: 'Health Connect', alt: 'Android Health Connect 로고' },
];
---

<Layout
  title="글루밍 · 나의 몸을 이해하는 새로운 방식을 제안합니다"
  description="글루밍은 혈당을 자동으로 재주는 작은 센서 값을 식사·운동 같은 행동과 이어주는 생활습관 관리 보조 서비스예요. 이미 오른 혈당을 뒤늦게 확인하는 대신, 앞으로의 혈당 변화를 미리 살펴봐요."
>
  <!-- ── 1. HERO ───────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">A Wellness Companion</p>
        <h1 class="hero-title">
          나의 몸을 이해하는<br />
          <span class="accent">새로운 방식</span>을<br />
          제안합니다.
        </h1>
        <p class="hero-lead">
          글루밍은 몸에 붙이는 작은 혈당 센서가 잰 값을,<br />
          식사·운동 같은 하루 행동과 이어드려요.<br />
          지나간 숫자를 들여다보는 대신, <strong>행동하기 전에</strong> 내 혈당 흐름을
          미리 살펴봐요.
        </p>
        <div class="hero-cta">
          <StoreButtons size="lg" />
        </div>
        <p class="hero-note">
          <a href="/features">기능 둘러보기 →</a>
        </p>
      </div>

      <div class="hero-visual">
        <div class="hero-panel" aria-hidden="true"></div>
        <PhoneFrame width={292} class="hero-phone">
          <Image
            src={screens.homeGood}
            alt="글루밍 앱 홈 화면. 글루밍즈 캐릭터가 웃는 표정으로 '리듬이 아주 좋아요, 이대로 가요!'라고 알려주고, 혈당 94 mg/dL과 오늘의 점수·평균 혈당·변동성이 함께 보인다."
            widths={[300, 600]}
            sizes="292px"
            loading="eager"
          />
        </PhoneFrame>
      </div>
    </div>
  </section>

  <!-- ── 2. 신뢰 스트립 ─────────────────────────────────── -->
  <section class="trust">
    <div class="container trust-inner">
      <p class="trust-label">건강 데이터는 자동으로 이어져요</p>
      <ul class="trust-logos">
        {
          syncPlatforms.map((p) => (
            <li>
              <Image src={p.img} alt={p.alt} width={28} height={28} densities={[1, 2]} />
              <span>{p.name}</span>
            </li>
          ))
        }
      </ul>
      <p class="trust-note">
        의료기기가 아니에요 · 생활습관 관리를 돕는 웰니스 서비스예요
      </p>
    </div>
  </section>

  <!-- ── 3. 문제 정의 ──────────────────────────────────── -->
  <section class="section problem">
    <div class="container">
      <SectionHead eyebrow="01 — Why Gluming" variant="split">
        숫자는 쌓이는데,<br />뭘 바꿔야 할지는 막막하죠
        <Fragment slot="sub">
          이미 혈당이 오른 뒤에야 알림이 와서 그래프를 들여다봐요.<br />
          “아, 아까 그걸 먹지 말걸” 하고 아쉬워한 적, 한 번쯤 있지 않나요?
        </Fragment>
      </SectionHead>

      <div class="compare">
        <article class="compare-col is-before reveal">
          <span class="compare-tag">Before</span>
          <h3>오른 뒤에야 알게 돼요</h3>
          <svg class="mini" viewBox="0 0 260 96" role="img"
            aria-label="혈당이 목표 범위를 넘어 오른 뒤에야 확인하게 되는 흐름 그래프">
            <rect x="0" y="40" width="260" height="30" rx="6" class="mini-band" />
            <path d="M4 74 C 44 70 72 44 110 32 S 196 16 256 22" class="mini-line" />
            <circle cx="256" cy="22" r="3.6" class="mini-dot" />
            <text x="196" y="12" class="mini-cap">이미 지나감</text>
          </svg>
          <p>
            식사가 끝나고 혈당이 오른 다음에야 알림이 울려요.<br />
            그래프를 봐도 <strong>이미 지나간 일</strong>이라, 다음을 어떻게 바꿔야 할지
            혼자 고민하게 돼요.
          </p>
        </article>

        <article class="compare-col is-after reveal">
          <span class="compare-tag accent">Gluming</span>
          <h3>변화를 미리 살펴봐요</h3>
          <svg class="mini" viewBox="0 0 260 96" role="img"
            aria-label="지금 이후의 혈당 흐름을 점선으로 미리 그려 보여주는 그래프">
            <rect x="0" y="40" width="260" height="30" rx="6" class="mini-band is-on" />
            <line x1="112" y1="10" x2="112" y2="86" class="mini-now" />
            <path d="M4 70 C 40 66 76 58 112 56" class="mini-line is-on" />
            <path d="M112 56 C 148 52 176 46 206 50 S 242 58 256 52" class="mini-pred" />
            <circle cx="112" cy="56" r="3.6" class="mini-dot is-on" />
            <circle cx="256" cy="52" r="3.6" class="mini-dot-open" />
            <text x="118" y="16" class="mini-cap is-on">지금부터</text>
          </svg>
          <p>
            먹기 전에, 움직이기 전에 <strong>내 혈당이 어떻게 변할지</strong> 미리
            알려드려요.<br />
            무엇을 하면 좋을지까지 살며시 귀띔해 주니까, 오늘의 관리가 한결 쉬워져요.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ── 4. 핵심 기능 ──────────────────────────────────── -->
  <section class="section features">
    <div class="container">
      <SectionHead eyebrow="02 — Core Features" variant="split">
        행동을 바꾸기 쉽게,<br />부드럽게
        <Fragment slot="sub">
          복잡한 수치 해석은 글루밍에게 맡겨두세요.<br />
          아래는 모두 <strong>실제 앱 화면</strong>이에요.
        </Fragment>
      </SectionHead>

      <div class="cells feature-cells">
        {
          features.map((f, i) => (
            <ScreenCard
              img={f.img}
              title={f.title}
              alt={f.alt}
              index={String(i + 1).padStart(2, '0')}
            >
              {f.desc}
            </ScreenCard>
          ))
        }
      </div>

      <div class="center-cta">
        <Button href="/features" variant="secondary" size="md">
          기능 자세히 보기
        </Button>
      </div>
    </div>
  </section>

  <!-- ── 5. 글루밍즈 티저 ──────────────────────────────── -->
  <section class="section friends">
    <div class="container">
      <SectionHead eyebrow="03 — Meet the Glumings" variant="split">
        매일을 함께 걷는 친구들
        <Fragment slot="sub">
          기록도 습관도 혼자 하면 금세 지치잖아요.<br />
          글루밍즈가 곁에서 오늘의 작은 변화를 같이 응원할게요.
        </Fragment>
      </SectionHead>

      <div class="cells friend-cells">
        {characters.map((c) => <CharacterCard character={c} state="optimal" />)}
      </div>

      <div class="center-cta">
        <Button href="/characters" variant="secondary" size="md">
          글루밍즈 모두 만나기
        </Button>
      </div>
    </div>
  </section>

  <!-- ── 6. 최종 CTA ───────────────────────────────────── -->
  <section class="section cta-band-wrap">
    <div class="container">
      <div class="cta-band">
        <p class="eyebrow on-dark">Start Today</p>
        <h2 class="cta-title">오늘의 한 끼,<br />미리 살펴보고 시작해요</h2>
        <p class="cta-sub">
          행동하기 전에 내 혈당 흐름을 그려보는 습관.<br />
          지금 바로 시작해 보세요.
        </p>
        <div class="cta-actions">
          <StoreButtons size="lg" tone="dark" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ─────────────────────────────────────────── */
  .hero {
    padding: clamp(40px, 6vw, 88px) 0 clamp(48px, 7vw, 96px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.06fr 0.94fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .hero-title {
    margin-top: var(--sp-1);
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    letter-spacing: -0.045em;
  }
  .hero-title .accent {
    position: relative;
    white-space: nowrap;
    color: var(--sage-dark);
  }
  .hero-title .accent::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.06em;
    height: 0.32em;
    border-radius: 2px;
    background: color-mix(in srgb, var(--sand) 40%, transparent);
    z-index: -1;
  }
  .hero-lead {
    margin-top: var(--sp-6);
    max-width: 480px;
    color: var(--text-2);
    font-size: var(--fs-lead);
    line-height: 1.8;
  }
  .hero-lead strong {
    color: var(--text);
    font-weight: 700;
  }
  .hero-cta {
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .hero-note {
    margin-top: var(--sp-5);
  }
  .hero-note a {
    color: var(--sage-dark);
    font-weight: 600;
    font-size: var(--fs-body);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-2) var(--ease);
  }
  .hero-note a:hover {
    border-bottom-color: currentColor;
  }

  /* 에지 블리드 톤 패널 + 그 위에 놓인 앱 화면 */
  .hero-visual {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(28px, 4vw, 48px) 0;
  }
  .hero-panel {
    position: absolute;
    inset: 0 -50vw 0 2%;
    background: var(--warm);
    border-left: 1px solid var(--rule);
  }
  /* 자식 컴포넌트 루트에는 부모 스코프가 붙지 않으므로 :global 로 지정한다 */
  .hero-visual :global(.phone) {
    position: relative;
  }

  /* ── 신뢰 스트립 ───────────────────────────────────── */
  .trust {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--warm) 45%, transparent);
  }
  .trust-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-7);
    padding: var(--sp-4) 0;
  }
  .trust-label {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sage-dark);
  }
  .trust-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust-logos li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-2);
  }
  .trust-logos :global(img) {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }
  .trust-note {
    margin-left: auto;
    color: var(--text-3);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  /* ── 문제 정의 ─────────────────────────────────────── */
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--rule);
  }
  .compare-col {
    padding: var(--sp-7) clamp(24px, 4vw, 48px) var(--sp-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .compare-col.is-after {
    padding-left: clamp(24px, 4vw, 48px);
    padding-right: 0;
    border-left: 1px solid var(--rule);
  }
  .compare-col h3 {
    font-size: var(--fs-h3);
  }
  .compare-col.is-before h3 {
    color: var(--text-3);
  }
  .compare-col.is-after h3 {
    color: var(--pine);
  }
  .compare-col p {
    color: var(--text-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    max-width: 44ch;
  }
  .compare-tag {
    font-family: var(--font-serif);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .compare-tag.accent {
    color: var(--sage-dark);
  }

  /* 미니 그래프 — 말로 하던 대비를 눈으로 */
  .mini {
    width: 100%;
    max-width: 340px;
    height: auto;
    display: block;
  }
  .mini-band {
    fill: color-mix(in srgb, var(--text-3) 12%, transparent);
  }
  .mini-band.is-on {
    fill: color-mix(in srgb, var(--primary) 15%, transparent);
  }
  .mini-line {
    fill: none;
    stroke: var(--text-3);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .mini-line.is-on {
    stroke: var(--sage-dark);
  }
  .mini-pred {
    fill: none;
    stroke: var(--sage);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 4 5;
  }
  .mini-now {
    stroke: var(--border-strong);
    stroke-width: 1;
    stroke-dasharray: 3 4;
  }
  .mini-dot {
    fill: var(--text-3);
  }
  .mini-dot.is-on {
    fill: var(--sage-dark);
  }
  .mini-dot-open {
    fill: var(--surface);
    stroke: var(--sage);
    stroke-width: 2;
  }
  .mini-cap {
    fill: var(--text-3);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .mini-cap.is-on {
    fill: var(--sage-dark);
  }

  /* ── 격자 칸 ───────────────────────────────────────── */
  .feature-cells {
    grid-template-columns: repeat(3, 1fr);
  }
  .friend-cells {
    grid-template-columns: repeat(4, 1fr);
  }
  .center-cta {
    margin-top: var(--sp-7);
    display: flex;
    justify-content: center;
  }

  /* ── 최종 CTA — 파인 다크 밴드 ──────────────────────── */
  .cta-band {
    position: relative;
    padding: clamp(56px, 8vw, 104px) clamp(28px, 5vw, 72px);
    border-radius: var(--r-lg);
    text-align: center;
    background: var(--pine);
    color: var(--on-dark);
    overflow: hidden;
    isolation: isolate;
  }
  /* 다크 면에도 같은 종이 질감을 얹어 인쇄물처럼 (배경 위 · 내용 아래) */
  .cta-band::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--grain);
    background-size: 180px 180px;
    opacity: 0.07;
    pointer-events: none;
  }
  .eyebrow.on-dark {
    color: var(--primary-light);
  }
  .cta-title {
    font-size: var(--fs-h2);
    letter-spacing: -0.04em;
    line-height: var(--lh-title);
    color: var(--on-dark);
  }
  .cta-sub {
    margin: var(--sp-5) auto var(--sp-7);
    max-width: 500px;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: color-mix(in srgb, var(--on-dark) 78%, transparent);
  }
  .cta-actions {
    display: flex;
    justify-content: center;
  }
  .cta-band :global(.btn-primary) {
    background: var(--on-dark);
    color: var(--pine);
  }
  .cta-band :global(.btn-primary:hover) {
    background: #ffffff;
  }

  /* ── 반응형 ────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      text-align: center;
    }
    .hero-lead {
      margin-inline: auto;
    }
    .hero-cta {
      justify-content: center;
    }
    .hero-visual {
      order: -1;
    }
    .hero-panel {
      inset: 0 -24px;
      border-left: 0;
      border-radius: var(--r-lg);
    }
    .trust-note {
