---
import { Image } from 'astro:assets';
import type { CharacterInfo } from '../lib/assets';

// 화보식 캐릭터 셀 — 위쪽은 꽉 찬 인물면, 아래는 이름·한 줄 소개.
interface Props {
  character: CharacterInfo;
  state?: keyof CharacterInfo['states'];
}
const { character, state = 'optimal' } = Astro.props;
---

<article class="cell char-cell reveal" style={`--accent:${character.accent}`}>
  <div class="art">
    <Image
      src={character.states[state]}
      alt={`글루밍즈 캐릭터 ${character.name}`}
      width={220}
      height={220}
      densities={[1, 2]}
    />
  </div>
  <div class="meta">
    <h3>{character.name}</h3>
    <p>{character.tagline}</p>
  </div>
</article>

<style>
  /* 셀 기본 여백을 지우고 인물면을 끝까지 채운다 */
  .char-cell {
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .art {
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
    padding: var(--sp-5);
    background: radial-gradient(
      circle at 50% 42%,
      color-mix(in srgb, var(--accent) 18%, transparent),
      transparent 64%
    );
  }
  .art :global(img) {
    width: 76%;
    height: auto;
    object-fit: contain;
    transition: transform var(--dur-3) var(--ease);
  }
  .char-cell:hover .art :global(img) {
    transform: translateY(-4px);
  }
  .meta {
    margin-top: auto;
    padding: var(--sp-4) var(--sp-5) var(--sp-6);
    border-top: 1px solid var(--rule);
  }
  .meta h3 {
    font-size: var(--fs-h4);
    letter-spacing: -0.03em;
  }
  .meta p {
    margin-top: var(--sp-2);
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: 1.65;
  }
</style>
