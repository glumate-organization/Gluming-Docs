---
// 등록·수상 상패 — 파인 다크 면 위에 엠블럼(월계수 / 방패) + 기관 · 제목.
// 화면에 들어오면 월계수 잎이 아래에서 위로 한 장씩 돋아나고, 방패 테두리가 그려진다 (CSS 스크롤 타임라인, JS 0).
// 미지원 브라우저·모션 줄이기 설정에서는 처음부터 완성된 모습으로 보인다.
import { credentials, ipSummary } from '../lib/trust';

// 월계수 한쪽 가지 — 반지름 46 원호의 왼쪽(아래 240° → 위 110°)을 따라 잎 7장. 반대쪽은 좌우 반전.
const R = 46;
const leaves = Array.from({ length: 7 }, (_, i) => {
  const deg = 240 - i * 21.5;
  const rad = (deg * Math.PI) / 180;
  return {
    i,
    x: 60 + R * Math.cos(rad),
    y: 60 - R * Math.sin(rad),
    rot: 90 - deg - 28, // 원호 접선에서 바깥으로 살짝 벌린다 (SVG 회전은 시계 방향)
    size: 1 - i * 0.06, // 위로 갈수록 작아진다
  };
});
---

<div class="creds">
  {
    credentials.map((c) => (
      <article class="cred">
        <div class:list={['emblem', `is-${c.emblem}`]} aria-hidden="true">
          <svg viewBox="0 0 120 120" width="112" height="112">
            {c.emblem === 'laurel' ? (
              <>
                {[1, -1].map((side) => (
                  <g transform={side === -1 ? 'translate(120 0) scale(-1 1)' : undefined}>
                    <path class="stem" d="M44.3 103.2 A46 46 0 0 1 48.1 15.6" fill="none" />
                    {leaves.map((l) => (
                      <g transform={`translate(${l.x.toFixed(1)} ${l.y.toFixed(1)}) rotate(${l.rot})`}>
                        <ellipse
                          class="leaf"
                          style={`--i:${l.i}`}
                          rx={(9 * l.size).toFixed(1)}
                          ry={(4.2 * l.size).toFixed(1)}
                        />
                      </g>
                    ))}
                  </g>
                ))}
              </>
            ) : (
              <>
                <path
                  class="shield"
                  pathLength="1"
                  d="M60 14 L96 26 V58 C96 82 80 98 60 106 C40 98 24 82 24 58 V26 Z"
                  fill="none"
                />
                <path
                  class="shield-inner"
                  d="M60 24 L88 33 V58 C88 77 76 90 60 97 C44 90 32 77 32 58 V33 Z"
                  fill="none"
                />
              </>
            )}
            <text x="60" y="66" text-anchor="middle" class="mark">
              {c.mark}
            </text>
          </svg>
        </div>
        <div class="cred-text">
          <p class="cred-org">
            {c.org}
            {c.date && <span class="cred-date">{c.date}</span>}
          </p>
          <h3 class="cred-title">{c.title}</h3>
          <p class="cred-sub">{c.sub}</p>
        </div>
      </article>
    ))
  }
  <p class="ip">
    <span class="ip-label">지식재산</span>
    {
      ipSummary.map((x) => (
        <span class="ip-item">
          {x.label} {x.kind} <b>{x.count}</b>건
        </span>
      ))
    }
  </p>
</div>

<style>
  .creds {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--pine);
    color: var(--on-dark);
    border-radius: var(--r-lg);
    overflow: hidden;
    isolation: isolate;
  }
  /* 다크 면에도 종이 질감 */
  .creds::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--grain);
    background-size: 180px 180px;
    opacity: 0.07;
    pointer-events: none;
  }
  .cred {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 32px);
    padding: clamp(28px, 3.6vw, 44px) clamp(24px, 3.4vw, 48px);
  }
  .cred + .cred {
    border-left: 1px solid color-mix(in srgb, var(--on-dark) 16%, transparent);
  }

  /* ── 지식재산 한 줄 — 두 칸 아래 전체 폭, 작게 ── */
  .ip {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 18px;
    padding: 14px clamp(24px, 3.4vw, 48px);
    border-top: 1px solid color-mix(in srgb, var(--on-dark) 16%, transparent);
    color: color-mix(in srgb, var(--on-dark) 70%, transparent);
    font-size: var(--fs-xs);
  }
  .ip-label {
    color: var(--primary-light);
    font-weight: 600;
  }
  .ip-item b {
    color: var(--on-dark);
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 14px;
  }

  /* ── 엠블럼 ── */
  .emblem {
    flex: none;
    color: var(--primary-light);
  }
  .emblem svg {
    display: block;
    width: clamp(84px, 8vw, 112px);
    height: auto;
    overflow: visible;
  }
  .stem {
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.7;
  }
  /* 잎은 자기 <g>의 원점(0,0)에 그려 두고, 그 자리에서 커진다 — rotate 중심과 겹치지 않게 */
  .leaf {
    fill: currentColor;
    transform-origin: 0 0;
  }
  .shield {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .shield-inner {
    stroke: currentColor;
    stroke-width: 0.8;
    opacity: 0.5;
    stroke-dasharray: 2 3;
  }
  .mark {
    fill: var(--on-dark);
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* ── 글 ── */
  .cred-org {
    display: flex;
    align-items: center;
    gap: 10px;
    color: color-mix(in srgb, var(--on-dark) 70%, transparent);
    font-size: var(--fs-sm);
  }
  .cred-date {
    padding: 2px 8px;
    border: 1px solid color-mix(in srgb, var(--on-dark) 30%, transparent);
    border-radius: var(--r-pill);
    font-family: var(--font-serif);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .cred-title {
    margin-top: var(--sp-2);
    color: var(--on-dark);
    font-size: var(--fs-h4);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.4;
    text-wrap: balance;
  }
  .cred-sub {
    margin-top: 2px;
    color: var(--primary-light);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  /* ── 등장: 잎이 아래부터 한 장씩, 방패는 테두리가 그려진다 ── */
  @keyframes leaf-in {
    from {
      opacity: 0;
      scale: 0.2;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }
  @keyframes draw {
    from {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    to {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 10px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cred {
        view-timeline: --cred block;
      }
      .leaf {
        animation: leaf-in linear both;
        animation-timeline: --cred;
        animation-range: entry calc(20% + var(--i) * 6%) entry calc(36% + var(--i) * 6%);
      }
      .shield {
        animation: draw linear both;
        animation-timeline: --cred;
        animation-range: entry 20% entry 80%;
      }
      .cred-text {
        animation: rise linear both;
        animation-timeline: --cred;
        animation-range: entry 30% entry 75%;
      }
    }
  }

  @media (max-width: 760px) {
    .creds {
      grid-template-columns: 1fr;
    }
    .cred + .cred {
      border-left: 0;
      border-top: 1px solid color-mix(in srgb, var(--on-dark) 16%, transparent);
    }
  }
</style>
